---
import { ClientRouter } from "astro:transitions";
import SiteFooter from "../components/common/SiteFooter.astro";
import SiteHeader from "../components/common/SiteHeader.astro";
import {
  landingContent,
  needsClientInput,
  type Approval,
} from "../content/landing";
import "../styles/global.css";

type Props = {
  title?: Approval<string>;
  description?: Approval<string>;
};

const {
  description = landingContent.metadata.description,
  title = landingContent.metadata.title,
} = Astro.props;

const FONT_URL =
  "https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Caveat:wght@500;600;700&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&display=swap";

const pageTitle = title === needsClientInput ? "Puff Cross Media" : title;
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffd100" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={FONT_URL} />
    <link
      href={FONT_URL}
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link href={FONT_URL} rel="stylesheet" />
    </noscript>
    <ClientRouter />
  </head>
  <body class="bg-brand-yellow text-ink antialiased">
    <a
      class="sr-only z-50 bg-brand-yellow px-5 py-3 font-label text-label font-bold uppercase tracking-widest text-ink focus:fixed focus:left-gutter focus:top-4 focus:not-sr-only"
      href="#main-content"
    >
      Skip to main content
    </a>
    <SiteHeader items={landingContent.primaryNavigation} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />

    <script>
      import { initHashScroll } from "../scripts/hash-scroll";

      initHashScroll();
    </script>
  </body>
</html>
