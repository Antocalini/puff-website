---
import { ClientRouter } from "astro:transitions";
import SiteFooter from "../components/common/SiteFooter.astro";
import SiteHeader from "../components/common/SiteHeader.astro";
import Preloader from "../components/ui/Preloader.astro";
import SmartCursor from "../components/ui/SmartCursor.astro";
import {
  landingContent,
  needsClientInput,
  type Approval,
} from "../content/landing";
import "../styles/global.css";

type Props = {
  title?: Approval<string>;
  description?: Approval<string>;
  showPreloader?: boolean;
};

const {
  description = landingContent.metadata.description,
  title = landingContent.metadata.title,
  showPreloader = false,
} = Astro.props;

const FONT_URL =
  "https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Caveat:wght@500;600;700&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&family=Inter:wght@400;500;600;700&display=swap";

const pageTitle =
  title === needsClientInput
    ? "Puff Cross Media | On-Demand Design Subscription for Growing Brands"
    : title;

const pageDesc =
  description === needsClientInput
    ? "Scale your brand with senior-level packaging, branding, and digital design delivered in 48 hours. Flat monthly pricing. Pause or cancel anytime."
    : description;

const schemaData = {
  "@context": "https://schema.org",
  "@type": ["ProfessionalService", "Organization"],
  name: "Puff Cross Media",
  url: "https://puffcrossmedia.com",
  description:
    "On-demand design subscription service delivering high-converting packaging, brand identity, and marketing assets with 48-hour turnarounds.",
  areaServed: [
    { "@type": "Country", "name": "United States" },
    { "@type": "State", "name": "Texas" },
  ],
  priceRange: "$$$",
  knowsAbout: [
    "Design as a Service",
    "Packaging Design",
    "Brand Identity",
    "FMCG Branding",
    "Digital & Motion Design",
  ],
};
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="theme-color" content="#ffd100" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- OpenGraph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:site_name" content="Puff Cross Media" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />

    <!-- Geographic metadata for Texas & US local trust -->
    <meta name="geo.region" content="US-TX" />
    <meta name="geo.placename" content="Texas" />

    <!-- Structured Data (Schema.org JSON-LD) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={FONT_URL} />
    <link
      href={FONT_URL}
      rel="stylesheet"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link href={FONT_URL} rel="stylesheet" />
    </noscript>
    <ClientRouter />
  </head>
  <body class="bg-brand-yellow text-ink antialiased">
    <SmartCursor />
    {showPreloader && <Preloader />}
    <a
      class="sr-only z-50 bg-brand-yellow px-5 py-3 font-label text-label font-bold uppercase tracking-widest text-ink focus:fixed focus:left-gutter focus:top-4 focus:not-sr-only"
      href="#main-content"
    >
      Skip to main content
    </a>
    <SiteHeader items={landingContent.primaryNavigation} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />

    <script>
      import { initHashScroll } from "../scripts/hash-scroll";

      initHashScroll();
    </script>
  </body>
</html>
