---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import "../../styles/components/floating-sticker.css";

type Peel = "tl" | "tr" | "bl" | "br";
type PresetSize = "whisper" | "accent" | "moment" | "lead";
/** Preset token or any CSS width: `18rem`, `min(78%, 16rem)`, `clamp(12rem, 28vw, 20rem)`, etc. */
type Size = PresetSize | (string & {});

const PRESET_SIZES: PresetSize[] = ["whisper", "accent", "moment", "lead"];

function isPresetSize(value: string): value is PresetSize {
  return PRESET_SIZES.includes(value as PresetSize);
}

interface Props {
  src: ImageMetadata;
  peel?: Peel;
  size?: Size;
  /** Override default peel tilt (degrees, negative = counter-clockwise). */
  rotate?: number;
  /** Show on mobile too. Defaults to true so mobile matches desktop composition. */
  alwaysVisible?: boolean;
  /** Gentle tilt rock (left ↔ right) + subtle vertical float. */
  motion?: "drift";
  inline?: boolean;
  class?: string;
  loading?: "eager" | "lazy";
}

const {
  src,
  peel = "tr",
  size = "accent",
  rotate,
  alwaysVisible = true,
  motion,
  inline = false,
  class: className = "",
  loading = "lazy",
} = Astro.props;

const customRotate = rotate !== undefined;
const customSize = isPresetSize(size) ? undefined : size;
const presetSize = isPresetSize(size) ? size : "accent";
const motionDrift = motion === "drift";

const PEEL_ROTATE: Record<Peel, number> = {
  tl: -8,
  tr: 8,
  bl: -12,
  br: 10,
};

const rotateCenter = rotate ?? PEEL_ROTATE[peel];

const wrapperStyle = [
  customRotate || motionDrift ? `--sticker-rotate: ${rotateCenter}deg` : null,
  motionDrift ? "--sticker-rock-range: 5deg" : null,
  customSize ? `--sticker-width: ${customSize}` : null,
]
  .filter(Boolean)
  .join("; ");

const imgStyle =
  customRotate && !motionDrift ? `transform: rotate(${rotate}deg)` : undefined;
---

<div
  class:list={[
    "floating-sticker pointer-events-auto z-20",
    alwaysVisible ? "block" : "hidden md:block",
    inline ? "relative shrink-0" : "absolute",
    `floating-sticker--peel-${peel}`,
    customSize
      ? "floating-sticker--size-custom"
      : `floating-sticker--size-${presetSize}`,
    customRotate && !motionDrift && "floating-sticker--custom-rotate",
    motionDrift && "floating-sticker--motion-drift",
    className,
  ]}
  style={wrapperStyle || undefined}
  aria-hidden="true"
>
  <Image
    src={src}
    alt=""
    class="floating-sticker__img"
    loading={loading}
    decoding="async"
    style={imgStyle}
  />
</div>
