---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Peel = "tl" | "tr" | "bl" | "br";
type PresetSize = "whisper" | "accent" | "moment" | "lead";
/** Preset token or any CSS width: `18rem`, `min(78%, 16rem)`, `clamp(12rem, 28vw, 20rem)`, etc. */
type Size = PresetSize | (string & {});

const PRESET_SIZES: PresetSize[] = ["whisper", "accent", "moment", "lead"];

function isPresetSize(value: string): value is PresetSize {
  return PRESET_SIZES.includes(value as PresetSize);
}

interface Props {
  src: ImageMetadata;
  peel?: Peel;
  size?: Size;
  /** Override default peel tilt (degrees, negative = counter-clockwise). */
  rotate?: number;
  /** Show on mobile too. Defaults to true so mobile matches desktop composition. */
  alwaysVisible?: boolean;
  /** Gentle tilt rock (left ↔ right) + subtle vertical float. */
  motion?: "drift";
  inline?: boolean;
  class?: string;
  loading?: "eager" | "lazy";
}

const {
  src,
  peel = "tr",
  size = "accent",
  rotate,
  alwaysVisible = true,
  motion,
  inline = false,
  class: className = "",
  loading = "lazy",
} = Astro.props;

const customRotate = rotate !== undefined;
const customSize = isPresetSize(size) ? undefined : size;
const presetSize = isPresetSize(size) ? size : "accent";
const motionDrift = motion === "drift";

const PEEL_ROTATE: Record<Peel, number> = {
  tl: -8,
  tr: 8,
  bl: -12,
  br: 10,
};

const rotateCenter = rotate ?? PEEL_ROTATE[peel];

const wrapperStyle = [
  customRotate || motionDrift ? `--sticker-rotate: ${rotateCenter}deg` : null,
  motionDrift ? "--sticker-rock-range: 5deg" : null,
  customSize ? `--sticker-width: ${customSize}` : null,
]
  .filter(Boolean)
  .join("; ");

const imgStyle =
  customRotate && !motionDrift ? `transform: rotate(${rotate}deg)` : undefined;
---

<div
  class:list={[
    "floating-sticker pointer-events-auto z-20",
    alwaysVisible ? "block" : "hidden md:block",
    inline ? "relative shrink-0" : "absolute",
    `floating-sticker--peel-${peel}`,
    customSize
      ? "floating-sticker--size-custom"
      : `floating-sticker--size-${presetSize}`,
    customRotate && !motionDrift && "floating-sticker--custom-rotate",
    motionDrift && "floating-sticker--motion-drift",
    className,
  ]}
  style={wrapperStyle || undefined}
  aria-hidden="true"
>
  <Image
    src={src}
    alt=""
    class="floating-sticker__img"
    loading={loading}
    decoding="async"
    style={imgStyle}
  />
</div>

<style>
  .floating-sticker {
    cursor: grab;
  }

  .floating-sticker:active {
    cursor: grabbing;
  }

  .floating-sticker__img {
    display: block;
    height: auto;
    filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.16));
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  /* Size scale — matches editorial sticker system */
  .floating-sticker--size-whisper .floating-sticker__img {
    width: min(12vw, 120px);
  }

  .floating-sticker--size-accent .floating-sticker__img {
    width: min(16vw, 180px);
  }

  @media (min-width: 1024px) {
    .floating-sticker--size-accent .floating-sticker__img {
      width: min(17vw, 200px);
    }
  }

  .floating-sticker--size-moment .floating-sticker__img {
    width: min(22vw, 260px);
  }

  @media (min-width: 1024px) {
    .floating-sticker--size-moment .floating-sticker__img {
      width: min(24vw, 280px);
    }
  }

  .floating-sticker--size-lead .floating-sticker__img {
    width: min(26vw, 340px);
  }

  @media (min-width: 1024px) {
    .floating-sticker--size-lead .floating-sticker__img {
      width: min(28vw, 380px);
    }
  }

  .floating-sticker--size-custom .floating-sticker__img {
    width: var(--sticker-width);
  }

  /* Ambient tilt rock on img + subtle bob on wrapper */
  .floating-sticker--motion-drift {
    animation: floating-sticker-bob 7s ease-in-out infinite;
    will-change: transform;
  }

  .floating-sticker--motion-drift .floating-sticker__img {
    animation: floating-sticker-rock 9s ease-in-out infinite;
    transition: filter 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    filter: drop-shadow(0 18px 32px rgba(0, 0, 0, 0.22));
  }

  .floating-sticker--motion-drift:hover .floating-sticker__img {
    filter: drop-shadow(0 24px 40px rgba(0, 0, 0, 0.28));
  }

  @keyframes floating-sticker-bob {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-5px);
    }
  }

  @keyframes floating-sticker-rock {
    0%,
    100% {
      transform: rotate(calc(var(--sticker-rotate) - var(--sticker-rock-range, 5deg)));
    }

    50% {
      transform: rotate(calc(var(--sticker-rotate) + var(--sticker-rock-range, 5deg)));
    }
  }

  /* Resting tilt + peel origin */
  .floating-sticker--peel-tl .floating-sticker__img {
    transform-origin: 18% 88%;
    transform: rotate(-8deg);
  }

  .floating-sticker--peel-tr .floating-sticker__img {
    transform-origin: 82% 88%;
    transform: rotate(8deg);
  }

  .floating-sticker--peel-bl .floating-sticker__img {
    transform-origin: 22% 92%;
    transform: rotate(-12deg);
  }

  .floating-sticker--peel-br .floating-sticker__img {
    transform-origin: 78% 92%;
    transform: rotate(10deg);
  }

  /* Custom rotate: resting tilt is inline on the img (beats scoped peel CSS).
     Hover/active still use the CSS variable + !important. */

  .floating-sticker--peel-tl:not(.floating-sticker--motion-drift):hover
    .floating-sticker__img {
    transform: translate(-6px, -14px) rotate(-13deg) scale(1.02);
    filter: drop-shadow(0 22px 34px rgba(0, 0, 0, 0.22));
  }

  .floating-sticker--peel-tr:not(.floating-sticker--motion-drift):hover
    .floating-sticker__img {
    transform: translate(6px, -14px) rotate(13deg) scale(1.02);
    filter: drop-shadow(0 22px 34px rgba(0, 0, 0, 0.22));
  }

  .floating-sticker--peel-bl:not(.floating-sticker--motion-drift):hover
    .floating-sticker__img {
    transform: translate(-4px, -16px) rotate(-18deg) scale(1.02);
    filter: drop-shadow(0 22px 34px rgba(0, 0, 0, 0.22));
  }

  .floating-sticker--peel-br:not(.floating-sticker--motion-drift):hover
    .floating-sticker__img {
    transform: translate(4px, -16px) rotate(16deg) scale(1.02);
    filter: drop-shadow(0 22px 34px rgba(0, 0, 0, 0.22));
  }

  .floating-sticker--custom-rotate.floating-sticker--peel-tl:hover
    .floating-sticker__img {
    transform: translate(-6px, -14px) rotate(calc(var(--sticker-rotate) - 5deg))
      scale(1.02) !important;
    filter: drop-shadow(0 22px 34px rgba(0, 0, 0, 0.22));
  }

  .floating-sticker--custom-rotate.floating-sticker--peel-tr:hover
    .floating-sticker__img {
    transform: translate(6px, -14px) rotate(calc(var(--sticker-rotate) - 5deg))
      scale(1.02) !important;
    filter: drop-shadow(0 22px 34px rgba(0, 0, 0, 0.22));
  }

  .floating-sticker--custom-rotate.floating-sticker--peel-bl:hover
    .floating-sticker__img {
    transform: translate(-4px, -16px) rotate(calc(var(--sticker-rotate) - 6deg))
      scale(1.02) !important;
    filter: drop-shadow(0 22px 34px rgba(0, 0, 0, 0.22));
  }

  .floating-sticker--custom-rotate.floating-sticker--peel-br:hover
    .floating-sticker__img {
    transform: translate(4px, -16px) rotate(calc(var(--sticker-rotate) - 5deg))
      scale(1.02) !important;
    filter: drop-shadow(0 22px 34px rgba(0, 0, 0, 0.22));
  }

  .floating-sticker--peel-tl:not(.floating-sticker--motion-drift):active
    .floating-sticker__img {
    transform: translate(-3px, -8px) rotate(-10deg) scale(1.01);
  }

  .floating-sticker--peel-tr:not(.floating-sticker--motion-drift):active
    .floating-sticker__img {
    transform: translate(3px, -8px) rotate(10deg) scale(1.01);
  }

  .floating-sticker--peel-bl:not(.floating-sticker--motion-drift):active
    .floating-sticker__img {
    transform: translate(-2px, -9px) rotate(-14deg) scale(1.01);
  }

  .floating-sticker--peel-br:not(.floating-sticker--motion-drift):active
    .floating-sticker__img {
    transform: translate(2px, -9px) rotate(12deg) scale(1.01);
  }

  .floating-sticker--custom-rotate.floating-sticker--peel-tl:active
    .floating-sticker__img {
    transform: translate(-3px, -8px) rotate(calc(var(--sticker-rotate) - 2deg))
      scale(1.01) !important;
  }

  .floating-sticker--custom-rotate.floating-sticker--peel-tr:active
    .floating-sticker__img {
    transform: translate(3px, -8px) rotate(calc(var(--sticker-rotate) - 2deg))
      scale(1.01) !important;
  }

  .floating-sticker--custom-rotate.floating-sticker--peel-bl:active
    .floating-sticker__img {
    transform: translate(-2px, -9px) rotate(calc(var(--sticker-rotate) - 3deg))
      scale(1.01) !important;
  }

  .floating-sticker--custom-rotate.floating-sticker--peel-br:active
    .floating-sticker__img {
    transform: translate(2px, -9px) rotate(calc(var(--sticker-rotate) - 2deg))
      scale(1.01) !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-sticker__img {
      transition: none;
    }

    .floating-sticker--peel-tl .floating-sticker__img,
    .floating-sticker--peel-tl:hover .floating-sticker__img,
    .floating-sticker--peel-tl:active .floating-sticker__img {
      transform: rotate(-8deg);
      filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.16));
    }

    .floating-sticker--peel-tr .floating-sticker__img,
    .floating-sticker--peel-tr:hover .floating-sticker__img,
    .floating-sticker--peel-tr:active .floating-sticker__img {
      transform: rotate(8deg);
      filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.16));
    }

    .floating-sticker--peel-bl .floating-sticker__img,
    .floating-sticker--peel-bl:hover .floating-sticker__img,
    .floating-sticker--peel-bl:active .floating-sticker__img {
      transform: rotate(-12deg);
      filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.16));
    }

    .floating-sticker--peel-br .floating-sticker__img,
    .floating-sticker--peel-br:hover .floating-sticker__img,
    .floating-sticker--peel-br:active .floating-sticker__img {
      transform: rotate(10deg);
      filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.16));
    }

    .floating-sticker--custom-rotate .floating-sticker__img,
    .floating-sticker--custom-rotate:hover .floating-sticker__img,
    .floating-sticker--custom-rotate:active .floating-sticker__img {
      transform: rotate(var(--sticker-rotate)) !important;
      filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.16));
    }

    .floating-sticker--motion-drift {
      animation: none;
    }

    .floating-sticker--motion-drift .floating-sticker__img {
      animation: none;
      transform: rotate(var(--sticker-rotate)) !important;
      filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.16));
    }
  }
</style>
