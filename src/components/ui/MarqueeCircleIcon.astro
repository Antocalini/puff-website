---
export type MarqueeIconName = "star" | "lightning" | "sparkle" | "smiley";

interface Props {
  name: MarqueeIconName;
  class?: string;
}

const { name, class: className = "size-8 md:size-9" } = Astro.props;
---

{
  name === "lightning" && (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z" />
    </svg>
  )
}

{
  name === "star" && (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M12 2 14.4 9.4 22 9.4l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6L12 2z" />
    </svg>
  )
}

{
  name === "sparkle" && (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M12 0C12 6.627 17.373 12 24 12 17.373 12 12 17.373 12 24 12 17.373 6.627 12 0 12C6.627 12 12 6.627 12 0Z" />
    </svg>
  )
}

{
  name === "smiley" && (
    <svg
      class={className}
      viewBox="0 0 32 32"
      fill="currentColor"
      aria-hidden="true"
    >
      <circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="2.25" />
      <circle cx="11.5" cy="13" r="2.25" />
      <circle cx="20.5" cy="13" r="2.25" />
      <path
        d="M10 20.5c2.2 3.2 5.2 4.5 6 4.5s3.8-1.3 6-4.5"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-width="2.25"
      />
    </svg>
  )
}
