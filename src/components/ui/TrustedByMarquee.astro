---
import { Image } from "astro:assets";
import { clientLogos, type ClientLogo } from "../../content/clientLogos";

interface Props {
  label?: string;
  logos?: readonly ClientLogo[];
  maskColor?: string;
  class?: string;
}

const {
  label = "Trusted By Teams At",
  logos = clientLogos,
  maskColor = "var(--color-brand-yellow)",
  class: className = "",
} = Astro.props;

const track = [...logos, ...logos];
---

<div
  class:list={["trusted-marquee mx-auto w-full max-w-md md:max-w-lg lg:max-w-xl", className]}
  style={`--trusted-marquee-mask: ${maskColor}`}
>
  <p
    class="mb-1.5 text-center font-label text-[0.8rem] font-semibold normal-case tracking-normal text-charcoal/55 md:mb-2 md:text-sm"
  >
    {label}
  </p>

  <div class="trusted-marquee-viewport relative overflow-hidden">
    <div class="flex overflow-hidden whitespace-nowrap select-none" aria-hidden="false">
      <div class="trusted-marquee-track flex shrink-0 items-center gap-5 pr-5 md:gap-7 md:pr-7">
        {
          track.map((item) => (
            <Image
              src={item.image}
              alt={item.name}
              class="marquee-logo-img h-8 w-auto max-w-[9rem] object-contain md:h-11 md:max-w-[12rem] opacity-60 grayscale contrast-125 transition-opacity"
              loading="eager"
              decoding="async"
            />
          ))
        }
      </div>
      <div class="trusted-marquee-track flex shrink-0 items-center gap-5 pr-5 md:gap-7 md:pr-7" aria-hidden="true">
        {
          track.map((item) => (
            <Image
              src={item.image}
              alt=""
              class="marquee-logo-img h-8 w-auto max-w-[9rem] object-contain md:h-11 md:max-w-[12rem] opacity-60 grayscale contrast-125 transition-opacity"
              loading="eager"
              decoding="async"
            />
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .trusted-marquee-viewport {
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 15%,
      black 85%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 15%,
      black 85%,
      transparent 100%
    );
  }

  .trusted-marquee-track {
    animation: trusted-marquee 90s linear infinite;
  }

  @keyframes trusted-marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trusted-marquee-track {
      animation: none;
    }
  }
</style>
