---
import { Image } from "astro:assets";
import { clientLogos, type ClientLogo } from "../../content/clientLogos";

interface Props {
  label?: string;
  logos?: readonly ClientLogo[];
  maskColor?: string;
  class?: string;
}

const {
  label = "Over 40+ fast-growing brands & creative teams use Puff",
  logos = clientLogos,
  maskColor = "var(--color-brand-yellow)",
  class: className = "",
} = Astro.props;

const track = [...logos, ...logos];
---

<div
  class:list={["trusted-marquee mx-auto w-full select-none", className]}
  style={`--trusted-marquee-mask: ${maskColor}`}
>
  <p
    class="mb-3 px-4 text-center font-label text-xs sm:text-sm font-semibold normal-case tracking-normal text-charcoal/75 text-balance"
  >
    {label}
  </p>

  <div class="trusted-marquee-viewport relative overflow-hidden py-1">
    <div class="flex overflow-hidden whitespace-nowrap select-none" aria-hidden="false">
      <div class="trusted-marquee-track flex shrink-0 items-center gap-8 pr-8 sm:gap-11 sm:pr-11">
        {
          track.map((item) => (
            <Image
              src={item.image}
              alt={item.name}
              class="marquee-logo-img h-12 sm:h-14 md:h-16 w-auto max-w-[9.5rem] sm:max-w-[12rem] md:max-w-[15rem] object-contain opacity-70 grayscale contrast-125 transition-opacity"
              loading="eager"
              decoding="async"
            />
          ))
        }
      </div>
      <div class="trusted-marquee-track flex shrink-0 items-center gap-8 pr-8 sm:gap-11 sm:pr-11" aria-hidden="true">
        {
          track.map((item) => (
            <Image
              src={item.image}
              alt=""
              class="marquee-logo-img h-12 sm:h-14 md:h-16 w-auto max-w-[9.5rem] sm:max-w-[12rem] md:max-w-[15rem] object-contain opacity-70 grayscale contrast-125 transition-opacity"
              loading="eager"
              decoding="async"
            />
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .trusted-marquee-viewport {
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
  }

  .trusted-marquee-track {
    animation: trusted-marquee 135s linear infinite;
  }

  .trusted-marquee-viewport:hover .trusted-marquee-track {
    animation-play-state: paused;
  }

  @keyframes trusted-marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trusted-marquee-track {
      animation: none;
    }
  }
</style>
