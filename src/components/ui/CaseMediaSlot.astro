---
import type { CaseMediaPosition, CaseMediaRatio, CaseMediaSpan } from "../../content/projects";

type Props = {
  label: string;
  ratio?: CaseMediaRatio;
  span?: CaseMediaSpan;
  src?: string;
  alt?: string;
  class?: string;
  parallax?: boolean;
  position?: CaseMediaPosition;
};

const {
  label,
  ratio = "landscape",
  span = "full",
  src,
  alt,
  class: className,
  parallax = true,
  position = "bottom",
} = Astro.props;

const ratioClass = {
  landscape: "aspect-[16/10]",
  portrait: "aspect-[9/16]",
  square: "aspect-square",
  wide: "aspect-[21/9]",
  standard: "aspect-[4/3]",
}[ratio];

const positionClass = {
  bottom: "object-[center_68%]",
  center: "object-[center_45%]",
  top: "object-top",
  upper: "object-[center_28%]",
}[position];

const isVerticalFull = ratio === "portrait" && span === "full";
const hasMedia = Boolean(src);
---

<figure
  class:list={["case-media group relative w-full overflow-hidden", className]}
  data-parallax-container={parallax ? "" : undefined}
>
  <div
    class:list={[
      ratioClass,
      "relative w-full overflow-hidden bg-charcoal",
      isVerticalFull && "max-h-[65vh] md:max-h-[70vh]",
    ]}
  >
    {
      hasMedia ? (
        <img
          class:list={[
            "w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02]",
            isVerticalFull ? positionClass : "object-center",
            parallax ? "h-[110%]" : "h-full",
          ]}
          data-parallax-img={parallax ? "" : undefined}
          src={src}
          alt={alt ?? label}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="absolute inset-0" aria-hidden="true">
          <div class="absolute inset-0 bg-[linear-gradient(160deg,#ffd100_0%,#f091f2_42%,#2447f5_100%)]" />
          <div class="absolute inset-x-0 bottom-0 h-px bg-paper/25" />
        </div>
      )
    }
  </div>
</figure>
