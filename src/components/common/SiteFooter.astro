---
import { landingContent } from "../../content/landing";
import FloatingSticker from "../ui/FloatingSticker.astro";
import footerSticker from "../../assets/images/stickers/footer.webp";
import "../../styles/components/footer.css";

const navLinks = [
  { label: "How it Works", href: "#how-it-works" },
  { label: "Pricing", href: "#pricing" },
  { label: "Work", href: "#work" },
  { label: "FAQ", href: "#faq" },
];

const legalLinks = [
  { label: "Privacy Policy", href: "/privacy" },
  { label: "Terms & Conditions", href: "/terms" },
];

const socialLinks = landingContent.header.value.socialLinks;
---

<footer
  class="site-footer relative z-0 w-full overflow-hidden bg-brand-yellow text-ink pt-16 sm:pt-24 md:pt-36 lg:pt-44 pb-0"
  data-nav-tone="yellow"
>
  <!-- Ambient circular watermark/glow in center (matching reference style) -->
  <div
    class="pointer-events-none absolute left-1/2 top-[42%] -translate-x-1/2 -translate-y-1/2 size-[min(90vw,38rem)] rounded-full bg-ink/[0.045] blur-2xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 w-full px-5 sm:px-8 md:px-12 lg:px-16 xl:px-20">
    <!-- Top 3-Column Editorial Grid (3-6-3 Distribution) -->
    <div
      class="grid grid-cols-1 gap-10 sm:gap-12 md:grid-cols-12 md:gap-6 lg:gap-10 items-start justify-between"
    >
      <!-- Col 1: Brand & Contact -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left md:col-span-3">
        <!-- Full Puff Cross Media logo (vector sharp) -->
        <svg
          class="h-9 sm:h-10 md:h-11 w-auto text-ink mb-4 sm:mb-5 md:mb-6"
          viewBox="0 0 72.85 35.41"
          aria-label="Puff Cross Media"
          role="img"
        >
          <path
            fill="currentColor"
            d="M63.25,16.9v.72l-5.71-.78v-5.61l5.71-.79v1.83h7.17v4.66l-7.17-.03ZM63.25,18.25l-5.71-.94v4.43l5.71,2.01v-5.5ZM45.96,24.88h1.15v-7.72h7.17v-.08l-12.88-2.11v4.6l4.56,5.31ZM52.8,3.22h-11.85v8.08l11.85-8.08ZM20.08,13.35v1.3c-.09,2.18.32,4.35,1.18,6.36l5.12-2.09c-.46-1.15-.66-2.39-.59-3.63v-1.6l-5.71-.35ZM38.52,9.76V3.43h-3.54l3.54,6.34ZM41.59,14.31l12.88,1.76v-4.2h-7.15v-4.02h7.49l.91-.33V3.2h-.79l-13.29,8.13-.04,2.99ZM57.53,10.77l5.71-1.01v-1.72h8.37V3.37h-1.56l-12.5,3.95v3.45ZM56.96,6.82l9.75-3.58h-9.73v3.58ZM7.7,23.99l-2.73.88h2.74v-.88ZM20.54,12.86l5.71.51v-4.47l-5.71-2.7v6.66ZM34.36,3.76h-1.33v11.53c0,3.76-1.06,5.12-3.33,5.12-.51.05-1.03-.05-1.49-.28-.46-.23-.84-.59-1.09-1.02l-4.98,2.28c1.41,2.57,3.93,3.8,7.59,3.8h.57l2.44-3.47-2.11,3.45c5.42-.33,7.93-3.71,7.93-10.53v-4.41l-4.19-6.47ZM57.13,22.21v2.51h5.71v-.19l-5.71-2.32ZM26.14,8.42V3.37h-5.71v2.01l5.71,3.05ZM40.99,19.48v5.2h3.89l-3.89-5.2ZM1.66,10.98l5.71.51v-3.74h1.93c2.19,0,3.45.72,3.45,2.6.02.55-.11,1.1-.36,1.6l5.67.51c.18-.69.26-1.4.26-2.11.01-.88-.12-1.76-.39-2.6L3.26,3.34h-1.66l.05,7.64ZM7.76,17.92h2.33c1.67.03,3.32-.33,4.82-1.03l-12.86,1.83v5.85h.26l5.45-1.53v-5.12ZM18.32,7.59c-1.13-3.29-4.53-4.41-8.37-4.41h-3.62l11.99,4.41ZM17.97,12.96l-5.89-.39c-.35.34-.77.6-1.23.76-.46.16-.95.22-1.44.18h-2.06v-1.24l-5.71-.38v5.85l13.33-1.11c1.41-.82,2.46-2.12,2.95-3.65l.05-.02Z"
          />
          <path
            fill="currentColor"
            d="M1.6,30.39c0-.68.15-1.28.44-1.81.29-.53.7-.95,1.22-1.24.53-.3,1.12-.45,1.79-.45.81,0,1.51.21,2.09.64.58.43.97,1.02,1.16,1.76h-1.84c-.14-.29-.33-.5-.59-.65-.25-.15-.53-.22-.85-.22-.51,0-.93.18-1.25.54-.32.36-.48.84-.48,1.44s.16,1.08.48,1.44c.32.36.74.54,1.25.54.32,0,.6-.07.85-.22.25-.15.45-.37.59-.65h1.84c-.2.74-.58,1.33-1.16,1.76-.58.42-1.28.64-2.09.64-.66,0-1.26-.15-1.79-.44-.52-.3-.93-.71-1.22-1.24-.29-.53-.44-1.13-.44-1.81ZM12.83,33.83l-1.43-2.59h-.4v2.59h-1.67v-6.86h2.8c.54,0,1,.09,1.38.28.38.19.67.45.86.78.19.33.28.69.28,1.09,0,.46-.13.86-.39,1.22-.25.36-.63.61-1.13.76l1.58,2.72h-1.89ZM11,30.06h1.04c.31,0,.53-.07.68-.22.16-.15.23-.36.23-.64s-.08-.47-.23-.62c-.15-.15-.38-.22-.68-.22h-1.04v1.7ZM18.95,33.9c-.64,0-1.24-.15-1.78-.45-.53-.3-.96-.72-1.28-1.25-.31-.54-.47-1.15-.47-1.82s.16-1.27.47-1.81c.32-.53.75-.95,1.28-1.25.54-.3,1.13-.45,1.78-.45s1.23.15,1.77.45c.54.3.96.72,1.27,1.25.31.53.47,1.14.47,1.81s-.16,1.28-.47,1.82c-.31.53-.74.95-1.27,1.25-.53.3-1.12.45-1.77.45ZM18.95,32.37c.55,0,.98-.18,1.31-.55.33-.36.5-.85.5-1.45s-.17-1.09-.5-1.45c-.33-.36-.76-.55-1.31-.55s-1,.18-1.33.54c-.33.36-.49.84-.49,1.46s.16,1.09.49,1.46c.33.36.78.54,1.33.54ZM25.87,33.9c-.5,0-.95-.08-1.35-.24s-.72-.4-.96-.72c-.23-.32-.36-.7-.37-1.15h1.78c.03.25.11.45.26.59.15.13.35.2.59.2s.44-.06.59-.17c.14-.12.21-.28.21-.48,0-.17-.06-.31-.18-.42-.11-.11-.25-.2-.42-.27-.16-.07-.4-.15-.7-.24-.44-.14-.8-.27-1.08-.41s-.52-.34-.72-.61-.3-.62-.3-1.05c0-.64.23-1.14.69-1.49.46-.36,1.06-.55,1.81-.55s1.36.18,1.83.55c.46.36.71.86.74,1.5h-1.81c-.01-.22-.09-.39-.24-.52-.15-.13-.34-.2-.58-.2-.2,0-.37.06-.49.17-.12.1-.19.26-.19.46,0,.22.1.39.31.52.21.12.53.26.98.4.44.15.8.29,1.07.43.28.14.52.34.72.6.2.26.3.6.3,1.01s-.1.75-.3,1.06c-.2.32-.48.57-.86.76-.38.19-.82.28-1.34.28ZM31.88,33.9c-.5,0-.95-.08-1.35-.24-.4-.16-.72-.4-.96-.72-.23-.32-.36-.7-.37-1.15h1.78c.03.25.11.45.26.59.15.13.35.2.59.2s.44-.06.59-.17c.14-.12.21-.28.21-.48,0-.17-.06-.31-.18-.42-.11-.11-.25-.2-.42-.27-.16-.07-.4-.15-.7-.24-.44-.14-.8-.27-1.08-.41-.28-.14-.52-.34-.72-.61-.2-.27-.3-.62-.3-1.05,0-.64.23-1.14.69-1.49.46-.36,1.06-.55,1.81-.55s1.37.18,1.83.55c.46.36.71.86.74,1.5h-1.81c-.01-.22-.09-.39-.24-.52-.15-.13-.34-.2-.58-.2-.2,0-.36.06-.49.17-.12.1-.19.26-.19.46,0,.22.1.39.31.52.21.12.53.26.98.4.44.15.8.29,1.07.43.28.14.52.34.72.6.2.26.3.6.3,1.01s-.1.75-.3,1.06c-.2.32-.48.57-.86.76-.38.19-.82.28-1.34.28ZM45.16,26.97v6.86h-1.67v-4.11l-1.53,4.11h-1.35l-1.54-4.12v4.12h-1.67v-6.86h1.97l1.92,4.75,1.91-4.75h1.96ZM48.62,28.31v1.39h2.24v1.29h-2.24v1.5h2.53v1.34h-4.2v-6.86h4.2v1.34h-2.53ZM55.39,26.97c.72,0,1.35.14,1.9.43s.96.69,1.25,1.21c.3.51.45,1.11.45,1.79s-.15,1.27-.45,1.79c-.29.52-.71.92-1.26,1.21-.54.29-1.17.43-1.89.43h-2.57v-6.86h2.57ZM55.28,32.38c.63,0,1.12-.17,1.48-.52.35-.35.53-.83.53-1.47s-.18-1.12-.53-1.48c-.35-.35-.84-.53-1.48-.53h-.79v3.99h.79ZM62.18,26.97v6.86h-1.67v-6.86h1.67ZM68.24,32.62h-2.56l-.41,1.21h-1.75l2.48-6.86h1.93l2.48,6.86h-1.77l-.41-1.21ZM67.82,31.33l-.85-2.51-.84,2.51h1.69Z"
          />
        </svg>

        <p
          class="font-label text-xs sm:text-sm font-bold uppercase tracking-[0.22em] text-ink/65 mb-2"
        >
          Contact
        </p>
        <a
          href="mailto:info@puffcrossmedia.com"
          class="font-display text-[clamp(1.75rem,7.5vw,3.25rem)] font-black uppercase tracking-tight text-ink underline decoration-ink/30 decoration-2 underline-offset-6 transition-all hover:decoration-ink hover:opacity-75 break-all sm:break-normal leading-[0.92]"
        >
          info@puffcrossmedia.com
        </a>
        <p
          class="mt-3 max-w-sm font-body text-xs sm:text-sm md:text-base leading-relaxed text-ink/75"
        >
          Async-first design on demand. Drop us a line or schedule an intro
          call.
        </p>
      </div>

      <!-- Col 2: Action / Collaboration (Center - Expanded Width & Size) -->
      <div
        class="flex flex-col items-center text-center w-full md:col-span-6"
      >
        <div class="mb-3 sm:mb-4">
          <FloatingSticker
            src={footerSticker}
            peel="tr"
            size="clamp(10rem, 18vw, 14.5rem)"
            rotate={-4}
            motion="drift"
            inline={true}
          />
        </div>

        <p
          class="font-display text-[clamp(3.25rem,5.8vw,6.25rem)] font-black uppercase leading-[0.84] tracking-tight text-ink text-balance"
        >
          Got a project? <br class="hidden sm:inline" />Want to collaborate?
        </p>

        <a
          href="#book-meeting"
          class="btn-3d-skeuo btn-shine group mt-6 sm:mt-7 inline-flex items-center gap-3.5 rounded-full px-7 py-4 sm:px-9 sm:py-4.5 font-label text-base sm:text-lg font-bold text-paper transition-all duration-200 hover:scale-[1.03] active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink"
        >
          <span>Discuss your project</span>
          <div
            class="flex size-7 sm:size-8 items-center justify-center rounded-full bg-paper/15 text-paper shadow-sm transition-all duration-300 group-hover:translate-x-1 group-hover:bg-brand-yellow group-hover:text-ink"
          >
            <svg
              class="size-3.5 sm:size-4 stroke-[2.5]"
              fill="none"
              viewBox="0 0 16 16"
              aria-hidden="true"
            >
              <path
                d="M3 8h9M8 3.5 12.5 8 8 12.5"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
        </a>
      </div>

      <!-- Col 3: Navigation & Info (Right on desktop, centered on mobile) -->
      <div
        class="flex flex-col items-center md:items-end text-center md:text-right w-full md:col-span-3"
      >
        <p
          class="font-label text-xs sm:text-sm font-bold uppercase tracking-[0.22em] text-ink/65 mb-2.5 sm:mb-3"
        >
          Explore
        </p>
        <ul
          class="flex flex-col items-center md:items-end gap-2 md:gap-2 font-display text-[clamp(2.5rem,8vw,4.5rem)] font-black uppercase leading-[0.88] tracking-tight text-ink"
        >
          {
            navLinks.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="transition-all duration-200 hover:text-ink/60 hover:scale-105 md:hover:scale-100 md:hover:-translate-x-2 inline-block py-0.5"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Meta row (Copyright, Legal, Socials) -->
    <div
      class="mt-12 sm:mt-16 md:mt-20 border-t border-ink/20 pt-6 pb-2 flex flex-col md:flex-row items-center justify-between gap-4 font-label text-xs uppercase tracking-widest text-ink/70 text-center md:text-left"
    >
      <p class="text-center md:text-left">© {new Date().getFullYear()} Puff Cross Media. All rights reserved.</p>

      <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6">
        {
          legalLinks.map(({ href, label }) => (
            <a
              href={href}
              class="transition-colors hover:text-ink underline-offset-4 hover:underline py-1"
            >
              {label}
            </a>
          ))
        }
      </div>

      <div class="flex items-center justify-center gap-4">
        {
          socialLinks.map(({ href, label, platform }) => (
            <a
              href={href}
              aria-label={label}
              class="text-ink/80 transition-colors hover:text-ink p-1"
            >
              {platform === "instagram" ? (
                <svg
                  aria-hidden="true"
                  class="size-4"
                  fill="none"
                  viewBox="0 0 18 18"
                >
                  <rect
                    height="12.5"
                    rx="3.25"
                    stroke="currentColor"
                    stroke-width="1.5"
                    width="12.5"
                    x="2.75"
                    y="2.75"
                  />
                  <circle
                    cx="9"
                    cy="9"
                    r="3"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                  <circle cx="13.1" cy="4.9" fill="currentColor" r="0.75" />
                </svg>
              ) : (
                <svg
                  aria-hidden="true"
                  class="size-4"
                  fill="currentColor"
                  viewBox="0 0 18 18"
                >
                  <path d="M10.2 9.6H12.3L13.1 6.8H10.2V5.1C10.2 4.4 10.4 3.9 11.5 3.9H13.2V1.4C12.9 1.4 11.9 1.2 10.8 1.2C8.5 1.2 7 2.5 7 4.8V6.8H4.5V9.6H7V16.8H10.2V9.6Z" />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Bottom Bleed Display Typography (LET'S WORK TOGETHER) -->
  <div
    class="w-full overflow-hidden select-none pointer-events-none mt-4 md:mt-6 leading-none"
  >
    <p
      class="footer-bleed-title font-display font-black text-ink uppercase tracking-[-0.03em] leading-[0.74] text-center w-full whitespace-nowrap text-[clamp(2.4rem,13vw,17.5rem)] translate-y-[13%] m-0 p-0"
    >
      LET'S WORK TOGETHER
    </p>
  </div>
</footer>
