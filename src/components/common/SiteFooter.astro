---
import { Image } from "astro:assets";
import { landingContent } from "../../content/landing";
import Button from "../ui/Button.astro";
import focusModeSticker from "../../assets/images/stickers/focus-mode.webp";
import madeToMakeItSticker from "../../assets/images/stickers/made-to-make-it.webp";

const navLinks = [
  { label: "How it Works", href: "#how-it-works" },
  { label: "Pricing", href: "#pricing" },
  { label: "Work", href: "#work" },
  { label: "FAQ", href: "#faq" },
];

const legalLinks = [
  { label: "Privacy Policy", href: "/privacy" },
  { label: "Terms & Conditions", href: "/terms" },
];

const socialLinks = landingContent.header.value.socialLinks;

const sectionLabel =
  "font-label text-xs font-bold uppercase tracking-[0.22em] text-paper/50";
const focusRing =
  "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-yellow focus-visible:ring-offset-2 focus-visible:ring-offset-ink";
const outlinePill = [
  "inline-flex items-center justify-center rounded-pill border-2 border-paper/40 bg-transparent px-5 py-2.5 font-body text-base font-semibold text-paper transition-colors duration-standard hover:border-brand-yellow hover:bg-brand-yellow hover:text-ink md:px-6 md:py-3 md:text-lg",
  focusRing,
].join(" ");
const navPill = [
  "inline-flex items-center justify-center rounded-pill border-2 border-brand-yellow bg-transparent px-5 py-2.5 font-body text-base font-semibold text-brand-yellow transition-colors duration-standard hover:bg-brand-yellow hover:text-ink md:px-6 md:py-3 md:text-lg",
  focusRing,
].join(" ");
---

<footer class="site-footer relative z-20 -mt-12 w-full md:-mt-16 lg:-mt-20" data-nav-tone="ink">
  <div class="footer-shell relative overflow-visible rounded-t-panel md:rounded-t-[2.75rem]">
    <div class="footer-surface-backdrop pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div
      class="footer-panel relative z-10 flex w-full flex-col overflow-hidden rounded-t-panel bg-ink text-paper md:rounded-t-[2.75rem]"
    >
      <div class="relative z-10 mx-auto w-full max-w-content px-gutter pb-8 pt-12 md:pb-10 md:pt-20 lg:pt-24">
        <div class="footer-layout flex flex-col gap-10 md:gap-12 lg:gap-14">
          <!-- Band 1 — Brand statement + accent sticker -->
          <div class="footer-band footer-band--brand">
            <p
              class="footer-headline font-display text-[clamp(2.85rem,11vw,7.5rem)] font-black uppercase leading-[0.88] tracking-tight text-paper text-balance"
            >
              Design that keeps
              <span
                class="text-highlight mt-1 block text-[0.52em] font-semibold normal-case leading-[0.95] tracking-normal text-brand-yellow"
              >
                your brand moving.
              </span>
            </p>

            <div class="footer-made-zone" aria-hidden="true">
              <Image
                src={madeToMakeItSticker}
                alt=""
                class="footer-made-sticker"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>

          <!-- Band 2 — Nav / legal + social / contact -->
          <div class="footer-band footer-band--utility">
            <div class="footer-utility-left flex flex-col gap-7 md:gap-8">
              <div>
                <p class={sectionLabel}>Navigation</p>
                <ul class="mt-4 flex flex-row flex-wrap items-center gap-2.5 md:gap-3">
                  {
                    navLinks.map(({ href, label }) => (
                      <li>
                        <a class={navPill} href={href}>
                          {label}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>

              <div>
                <p class={sectionLabel}>Legal</p>
                <ul class="mt-4 flex flex-row flex-wrap items-center gap-2.5 md:gap-3">
                  {
                    legalLinks.map(({ href, label }) => (
                      <li>
                        <a class={outlinePill} href={href}>
                          {label}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>

            <div class="footer-focus-zone" aria-hidden="true">
              <Image
                src={focusModeSticker}
                alt=""
                class="footer-focus-sticker"
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="footer-utility-right">
              <p class={sectionLabel}>Follow us</p>
              <ul class="mt-4 flex items-center gap-3.5">
                {
                  socialLinks.map(({ href, label, platform }) => (
                    <li>
                      <a
                        class:list={[
                          "footer-social-3d btn-3d-skeuo-yellow grid size-12 place-items-center rounded-full text-ink md:size-14",
                          focusRing,
                        ]}
                        aria-label={label}
                        href={href}
                      >
                        {platform === "instagram" ? (
                          <svg aria-hidden="true" class="size-5 md:size-6" fill="none" viewBox="0 0 18 18">
                            <rect
                              height="12.5"
                              rx="3.25"
                              stroke="currentColor"
                              stroke-width="1.5"
                              width="12.5"
                              x="2.75"
                              y="2.75"
                            />
                            <circle cx="9" cy="9" r="3" stroke="currentColor" stroke-width="1.5" />
                            <circle cx="13.1" cy="4.9" fill="currentColor" r="0.75" />
                          </svg>
                        ) : (
                          <svg aria-hidden="true" class="size-5 md:size-6" fill="currentColor" viewBox="0 0 18 18">
                            <path d="M10.2 9.6H12.3L13.1 6.8H10.2V5.1C10.2 4.4 10.4 3.9 11.5 3.9H13.2V1.4C12.9 1.4 11.9 1.2 10.8 1.2C8.5 1.2 7 2.5 7 4.8V6.8H4.5V9.6H7V16.8H10.2V9.6Z" />
                          </svg>
                        )}
                      </a>
                    </li>
                  ))
                }
              </ul>

              <p class={`${sectionLabel} mt-6 md:mt-7`}>Contact</p>
              <p class="mt-3 max-w-xs font-body text-base leading-relaxed text-paper/60 md:text-lg">
                Design on demand, no hassle. Book your free intro below.
              </p>
            </div>
          </div>

          <!-- Band 3 — Signature + single CTA -->
          <div class="footer-band footer-band--close">
            <div class="footer-brand">
              <div class="footer-logo-sticker">
                <svg
                  class="footer-wordmark text-brand-yellow"
                  viewBox="0 0 71.07 24"
                  aria-label="Puff"
                  role="img"
                >
                  <defs>
                    <filter
                      id="footer-puff-sticker-outline"
                      x="-24%"
                      y="-24%"
                      width="148%"
                      height="148%"
                      color-interpolation-filters="sRGB"
                    >
                      <feMorphology in="SourceAlpha" operator="dilate" radius="1.85" result="vinyl-shape"
                      ></feMorphology>
                      <feFlood flood-color="#ffffff" result="vinyl-color"></feFlood>
                      <feComposite
                        in="vinyl-color"
                        in2="vinyl-shape"
                        operator="in"
                        result="vinyl-outline"
                      ></feComposite>

                      <feMorphology in="SourceAlpha" operator="dilate" radius="0.82" result="ink-shape"
                      ></feMorphology>
                      <feFlood flood-color="#1a1a1a" result="ink-color"></feFlood>
                      <feComposite in="ink-color" in2="ink-shape" operator="in" result="ink-outline"
                      ></feComposite>

                      <feMerge>
                        <feMergeNode in="vinyl-outline"></feMergeNode>
                        <feMergeNode in="ink-outline"></feMergeNode>
                        <feMergeNode in="SourceGraphic"></feMergeNode>
                      </feMerge>
                    </filter>
                  </defs>
                  <path
                    fill="currentColor"
                    filter="url(#footer-puff-sticker-outline)"
                    d="M62.03,14.71v.72l-5.71-.78v-5.61l5.71-.79v1.83h7.17v4.66l-7.17-.03ZM62.03,16.07l-5.71-.94v4.43l5.71,2.01v-5.5ZM44.73,22.69h1.15v-7.72h7.17v-.08l-12.88-2.11v4.6l4.56,5.31ZM51.58,1.03h-11.85v8.08L51.58,1.03ZM18.86,11.17v1.3c-.09,2.18.32,4.35,1.18,6.36l5.12-2.09c-.46-1.15-.66-2.39-.59-3.63v-1.6l-5.71-.35ZM37.29,7.58V1.24h-3.54l3.54,6.34ZM40.37,12.13l12.88,1.76v-4.2h-7.15v-4.02h7.49l.91-.33V1.01h-.79l-13.29,8.13-.04,2.99ZM56.31,8.59l5.71-1.01v-1.72h8.37V1.19h-1.56l-12.5,3.95v3.45ZM55.74,4.63l9.75-3.58h-9.73v3.58ZM6.47,21.81l-2.73.88h2.74v-.88ZM19.32,10.68l5.71.51v-4.47l-5.71-2.7v6.66ZM33.14,1.58h-1.33v11.53c0,3.76-1.06,5.12-3.33,5.12-.51.05-1.03-.05-1.49-.28-.46-.23-.84-.59-1.09-1.02l-4.98,2.28c1.41,2.57,3.93,3.8,7.59,3.8h.57l2.44-3.47-2.11,3.45c5.42-.33,7.93-3.71,7.93-10.53v-4.41l-4.19-6.47ZM55.91,20.02v2.51h5.71v-.19l-5.71-2.32ZM24.91,6.24V1.18h-5.71v2.01l5.71,3.05ZM39.77,17.29v5.2h3.89l-3.89-5.2ZM.43,8.79l5.71.51v-3.74h1.93c2.19,0,3.45.72,3.45,2.6.02.55-.11,1.1-.36,1.6l5.67.51c.18-.69.26-1.4.26-2.11.01-.88-.12-1.76-.39-2.6L2.04,1.16H.38l.05,7.64ZM6.54,15.73h2.33c1.67.03,3.32-.33,4.82-1.03l-12.86,1.83v5.85h.26l5.45-1.53v-5.12ZM17.1,5.41C15.97,2.12,12.57,1,8.73,1h-3.62l11.99,4.41ZM16.75,10.78l-5.89-.39c-.35.34-.77.6-1.23.76-.46.16-.95.22-1.44.18h-2.06v-1.24l-5.71-.38v5.85l13.33-1.11c1.41-.82,2.46-2.12,2.95-3.65l.05-.02Z"
                  ></path>
                </svg>
              </div>

              <p
                class="mt-3 font-label text-[0.7rem] font-bold uppercase tracking-[0.18em] text-paper/40 md:mt-4"
              >
                © {new Date().getFullYear()} Puff Cross Media. All rights reserved.
              </p>
            </div>

            <div class="footer-cta-wrap">
              <div class="footer-cta-card relative overflow-visible rounded-[1.75rem] border border-brand-yellow/25 bg-[#fafafa] p-6 text-ink md:rounded-[2rem] md:p-7">
                <p class="font-label text-xs font-bold uppercase tracking-[0.22em] text-ink/45">
                  Next step
                </p>
                <p
                  class="footer-cta-headline mt-2.5 font-display text-[clamp(1.75rem,3vw,2.35rem)] font-black uppercase leading-[0.92] tracking-tight text-balance"
                >
                  Ready when
                  <span
                    class="text-highlight block text-[0.62em] font-semibold normal-case leading-[0.95] tracking-normal text-ink/70"
                  >
                    you are.
                  </span>
                </p>
                <p class="mt-3 max-w-sm font-body text-sm leading-relaxed text-ink/65 md:text-base">
                  Book a free 15-minute intro and see if Puff fits your next creative priority.
                </p>

                <div class="mt-5">
                  <Button href="#book-meeting" variant="primary">
                    Book a Call
                  </Button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  import { syncFooterSurface } from "../../scripts/footer-surface";

  function initFooterSurface() {
    syncFooterSurface();
    requestAnimationFrame(() => syncFooterSurface());
  }

  document.addEventListener("astro:page-load", initFooterSurface);
  window.addEventListener("resize", initFooterSurface);
</script>

<style>
  .footer-shell {
    padding-top: clamp(2rem, 4vw, 4rem);
  }

  .footer-surface-backdrop {
    background-color: var(--footer-surface-bg, var(--color-brand-yellow));
    background-image: var(--footer-surface-bg-image, none);
    background-size: cover;
    background-position: center top;
    border-radius: inherit;
  }

  .footer-panel {
    padding-top: clamp(1rem, 2vw, 1.5rem);
    padding-bottom: 0;
    background-color: var(--color-ink);
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  .footer-social-3d {
    border-radius: 9999px;
  }

  /* Band 1 — headline + made sticker */
  .footer-band--brand {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .footer-headline {
    flex: 1 1 auto;
    min-width: 0;
    padding-top: 1.25rem;
    padding-right: min(36vw, 9rem);
  }

  .footer-made-zone {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 4;
    pointer-events: none;
  }

  .footer-made-sticker {
    display: block;
    width: min(40vw, 10rem);
    height: auto;
    transform: rotate(9deg);
    filter: drop-shadow(0 12px 22px rgba(0, 0, 0, 0.32));
  }

  /* Band 2 — utility row + centered focus sticker */
  .footer-band--utility {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .footer-utility-left,
  .footer-utility-right {
    min-width: 0;
  }

  .footer-focus-zone {
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: none;
    z-index: 5;
    margin-block: -0.5rem;
  }

  .footer-focus-sticker {
    display: block;
    width: min(58vw, 14.5rem);
    height: auto;
    transform: rotate(11deg);
    filter: drop-shadow(0 12px 22px rgba(0, 0, 0, 0.32));
  }

  /* Band 3 — signature + CTA */
  .footer-band--close {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 0.5rem;
  }

  .footer-cta-wrap {
    order: -1;
  }

  .footer-brand {
    order: 1;
  }

  .footer-logo-sticker {
    display: inline-block;
    filter:
      drop-shadow(0 10px 18px rgba(0, 0, 0, 0.34))
      drop-shadow(0 3px 6px rgba(0, 0, 0, 0.22));
  }

  .footer-wordmark {
    display: block;
    width: min(82vw, 22rem);
    max-width: 100%;
    height: auto;
    margin: 0;
    overflow: visible;
  }

  .footer-cta-card {
    box-shadow: 0 6px 20px -10px rgba(0, 0, 0, 0.28);
  }

  @media (min-width: 768px) {
    .footer-headline {
      padding-top: 2rem;
      padding-right: min(24vw, 11rem);
    }

    .footer-made-sticker {
      width: min(26vw, 13rem);
    }

    .footer-focus-sticker {
      width: min(36vw, 16rem);
    }

    .footer-wordmark {
      width: min(42vw, 26rem);
    }
  }

  @media (min-width: 1024px) {
    .footer-band--brand {
      align-items: flex-end;
    }

    .footer-headline {
      padding-top: clamp(2rem, 3.5vw, 3.5rem);
      padding-right: 0;
      max-width: 68%;
    }

    .footer-made-zone {
      position: relative;
      top: auto;
      right: auto;
      flex: 0 0 auto;
      align-self: flex-start;
      margin-top: clamp(1.5rem, 3vw, 2.5rem);
    }

    .footer-made-sticker {
      width: min(22vw, 17rem);
      transform: rotate(8deg);
    }

    .footer-band--utility {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 3rem;
      min-height: clamp(12rem, 22vw, 16rem);
    }

    .footer-utility-left {
      flex: 1 1 55%;
      max-width: 42rem;
    }

    .footer-utility-right {
      flex: 0 1 auto;
      min-width: 14rem;
      padding-top: 0.15rem;
    }

    .footer-focus-zone {
      position: absolute;
      left: 50%;
      top: 50%;
      margin: 0;
      transform: translate(-50%, -50%);
    }

    .footer-focus-sticker {
      width: min(22vw, 19rem);
      transform: rotate(10deg);
    }

    .footer-band--close {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2.5rem;
      padding-top: 1rem;
    }

    .footer-cta-wrap {
      order: unset;
      flex: 0 1 22rem;
      width: 100%;
      max-width: 24rem;
    }

    .footer-brand {
      order: unset;
      flex: 1 1 auto;
      min-width: 0;
      padding-bottom: 0.25rem;
    }

    .footer-wordmark {
      width: min(36vw, 28rem);
    }
  }

  @media (min-width: 1280px) {
    .footer-band--utility {
      gap: 4rem;
    }

    .footer-focus-sticker {
      width: min(20vw, 21rem);
    }

    .footer-cta-wrap {
      max-width: 26rem;
    }
  }
</style>
