---
import { landingContent } from "../../content/landing";
import "../../styles/components/footer.css";

const navLinks = [
  { label: "How it Works", href: "#how-it-works" },
  { label: "Pricing", href: "#pricing" },
  { label: "Work", href: "#work" },
  { label: "FAQ", href: "#faq" },
];

const legalLinks = [
  { label: "Privacy Policy", href: "/privacy" },
  { label: "Terms & Conditions", href: "/terms" },
];

const socialLinks = landingContent.header.value.socialLinks;
---

<footer
  class="site-footer relative z-20 w-full overflow-hidden bg-brand-yellow text-ink pt-36 md:pt-52 lg:pt-64 pb-0"
  data-nav-tone="yellow"
>
  <!-- Ambient circular watermark/glow in center (matching reference style) -->
  <div
    class="pointer-events-none absolute left-1/2 top-[42%] -translate-x-1/2 -translate-y-1/2 size-[min(90vw,38rem)] rounded-full bg-ink/[0.045] blur-2xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 w-full px-6 sm:px-10 md:px-12 lg:px-16 xl:px-20">
    <!-- Top 3-Column Editorial Grid -->
    <div
      class="grid grid-cols-1 gap-12 md:grid-cols-3 md:gap-8 lg:gap-12 items-start justify-between"
    >
      <!-- Col 1: Brand & Contact -->
      <div class="flex flex-col items-start">
        <svg
          class="h-8 md:h-10 w-auto text-ink mb-6"
          viewBox="0 0 71.07 24"
          aria-label="Puff"
          role="img"
        >
          <path
            fill="currentColor"
            d="M62.03,14.71v.72l-5.71-.78v-5.61l5.71-.79v1.83h7.17v4.66l-7.17-.03ZM62.03,16.07l-5.71-.94v4.43l5.71,2.01v-5.5ZM44.73,22.69h1.15v-7.72h7.17v-.08l-12.88-2.11v4.6l4.56,5.31ZM51.58,1.03h-11.85v8.08L51.58,1.03ZM18.86,11.17v1.3c-.09,2.18.32,4.35,1.18,6.36l5.12-2.09c-.46-1.15-.66-2.39-.59-3.63v-1.6l-5.71-.35ZM37.29,7.58V1.24h-3.54l3.54,6.34ZM40.37,12.13l12.88,1.76v-4.2h-7.15v-4.02h7.49l.91-.33V1.01h-.79l-13.29,8.13-.04,2.99ZM56.31,8.59l5.71-1.01v-1.72h8.37V1.19h-1.56l-12.5,3.95v3.45ZM55.74,4.63l9.75-3.58h-9.73v3.58ZM6.47,21.81l-2.73.88h2.74v-.88ZM19.32,10.68l5.71.51v-4.47l-5.71-2.7v6.66ZM33.14,1.58h-1.33v11.53c0,3.76-1.06,5.12-3.33,5.12-.51.05-1.03-.05-1.49-.28-.46-.23-.84-.59-1.09-1.02l-4.98,2.28c1.41,2.57,3.93,3.8,7.59,3.8h.57l2.44-3.47-2.11,3.45c5.42-.33,7.93-3.71,7.93-10.53v-4.41l-4.19-6.47ZM55.91,20.02v2.51h5.71v-.19l-5.71-2.32ZM24.91,6.24V1.18h-5.71v2.01l5.71,3.05ZM39.77,17.29v5.2h3.89l-3.89-5.2ZM.43,8.79l5.71.51v-3.74h1.93c2.19,0,3.45.72,3.45,2.6.02.55-.11,1.1-.36,1.6l5.67.51c.18-.69.26-1.4.26-2.11.01-.88-.12-1.76-.39-2.6L2.04,1.16H.38l.05,7.64ZM6.54,15.73h2.33c1.67.03,3.32-.33,4.82-1.03l-12.86,1.83v5.85h.26l5.45-1.53v-5.12ZM17.1,5.41C15.97,2.12,12.57,1,8.73,1h-3.62l11.99,4.41ZM16.75,10.78l-5.89-.39c-.35.34-.77.6-1.23.76-.46.16-.95.22-1.44.18h-2.06v-1.24l-5.71-.38v5.85l13.33-1.11c1.41-.82,2.46-2.12,2.95-3.65l.05-.02Z"
          ></path>
        </svg>

        <p
          class="font-label text-xs md:text-sm font-bold uppercase tracking-[0.22em] text-ink/65 mb-2"
        >
          Contact
        </p>
        <a
          href="mailto:hello@puffcrossmedia.com"
          class="font-display text-[clamp(1.75rem,2.8vw,3.25rem)] font-black uppercase tracking-tight text-ink underline decoration-ink/30 decoration-2 underline-offset-6 transition-all hover:decoration-ink hover:opacity-75 break-words leading-[0.92]"
        >
          hello@puffcrossmedia.com
        </a>
        <p
          class="mt-4 max-w-sm font-body text-sm md:text-base leading-relaxed text-ink/75"
        >
          Async-first design on demand. Drop us a line or schedule an intro
          call.
        </p>
      </div>

      <!-- Col 2: Action / Collaboration (Center) -->
      <div
        class="flex flex-col items-start md:items-center text-left md:text-center"
      >
        <p
          class="font-display text-[clamp(2.5rem,4.4vw,4.5rem)] font-black uppercase leading-[0.88] tracking-tight text-ink text-balance"
        >
          Got a project? <br class="hidden sm:inline" />Want to collaborate?
        </p>

        <a
          href="#book-meeting"
          class="btn-3d-skeuo btn-shine group mt-6 inline-flex items-center gap-3.5 rounded-full px-8 py-4 font-label text-base font-bold text-paper transition-all duration-200 hover:scale-[1.03] active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink"
        >
          <span>Discuss your project</span>
          <div
            class="flex size-7 items-center justify-center rounded-full bg-paper/15 text-paper shadow-sm transition-all duration-300 group-hover:translate-x-1 group-hover:bg-brand-yellow group-hover:text-ink"
          >
            <svg
              class="size-3.5 stroke-[2.5]"
              fill="none"
              viewBox="0 0 16 16"
              aria-hidden="true"
            >
              <path
                d="M3 8h9M8 3.5 12.5 8 8 12.5"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
        </a>
      </div>

      <!-- Col 3: Navigation & Info (Right) -->
      <div
        class="flex flex-col items-start md:items-end text-left md:text-right"
      >
        <p
          class="font-label text-xs md:text-sm font-bold uppercase tracking-[0.22em] text-ink/65 mb-3"
        >
          Explore
        </p>
        <ul
          class="flex flex-col gap-1.5 md:gap-2 font-display text-[clamp(2.5rem,4.2vw,4.5rem)] font-black uppercase leading-[0.88] tracking-tight text-ink"
        >
          {
            navLinks.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="transition-all duration-200 hover:text-ink/60 hover:translate-x-2 md:hover:-translate-x-2 inline-block"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Meta row (Copyright, Legal, Socials) -->
    <div
      class="mt-14 md:mt-20 border-t border-ink/20 pt-6 pb-2 flex flex-col md:flex-row items-center justify-between gap-4 font-label text-xs uppercase tracking-widest text-ink/70"
    >
      <p>© {new Date().getFullYear()} Puff Cross Media. All rights reserved.</p>

      <div class="flex items-center gap-4">
        {
          legalLinks.map(({ href, label }) => (
            <a
              href={href}
              class="transition-colors hover:text-ink underline-offset-4 hover:underline"
            >
              {label}
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-4">
        {
          socialLinks.map(({ href, label, platform }) => (
            <a
              href={href}
              aria-label={label}
              class="text-ink/80 transition-colors hover:text-ink"
            >
              {platform === "instagram" ? (
                <svg
                  aria-hidden="true"
                  class="size-4"
                  fill="none"
                  viewBox="0 0 18 18"
                >
                  <rect
                    height="12.5"
                    rx="3.25"
                    stroke="currentColor"
                    stroke-width="1.5"
                    width="12.5"
                    x="2.75"
                    y="2.75"
                  />
                  <circle
                    cx="9"
                    cy="9"
                    r="3"
                    stroke="currentColor"
                    stroke-width="1.5"
                  />
                  <circle cx="13.1" cy="4.9" fill="currentColor" r="0.75" />
                </svg>
              ) : (
                <svg
                  aria-hidden="true"
                  class="size-4"
                  fill="currentColor"
                  viewBox="0 0 18 18"
                >
                  <path d="M10.2 9.6H12.3L13.1 6.8H10.2V5.1C10.2 4.4 10.4 3.9 11.5 3.9H13.2V1.4C12.9 1.4 11.9 1.2 10.8 1.2C8.5 1.2 7 2.5 7 4.8V6.8H4.5V9.6H7V16.8H10.2V9.6Z" />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Bottom Bleed Display Typography (LET'S WORK TOGETHER) -->
  <div
    class="w-full overflow-hidden select-none pointer-events-none mt-4 md:mt-6 leading-none"
  >
    <p
      class="footer-bleed-title font-display font-black text-ink uppercase tracking-[-0.03em] leading-[0.74] text-center w-full whitespace-nowrap text-[clamp(4.2rem,14.8vw,17.5rem)] translate-y-[13%] m-0 p-0"
    >
      LET'S WORK TOGETHER
    </p>
  </div>
</footer>
