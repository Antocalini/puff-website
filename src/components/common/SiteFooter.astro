---
import { Image } from "astro:assets";
import { landingContent } from "../../content/landing";
import Button from "../ui/Button.astro";
import FloatingSticker from "../ui/FloatingSticker.astro";
import focusModeSticker from "../../assets/images/stickers/focus-mode.webp";
import starSticker from "../../assets/images/stickers/star.webp";
import patternTexture from "../../assets/images/pattern-texture.png";
import "../../styles/components/footer.css";

const navLinks = [
  { label: "How it Works", href: "#how-it-works" },
  { label: "Pricing", href: "#pricing" },
  { label: "Work", href: "#work" },
  { label: "FAQ", href: "#faq" },
];

const legalLinks = [
  { label: "Privacy Policy", href: "/privacy" },
  { label: "Terms & Conditions", href: "/terms" },
];

const socialLinks = landingContent.header.value.socialLinks;

const sectionLabel =
  "font-label text-xs font-bold uppercase tracking-[0.22em] text-paper/50";
const focusRing =
  "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-yellow focus-visible:ring-offset-2 focus-visible:ring-offset-ink";
const outlinePill = [
  "inline-flex items-center justify-center rounded-pill border-2 border-paper/40 bg-transparent px-3.5 py-1.5 font-body text-sm font-semibold text-paper transition-colors duration-standard hover:border-brand-yellow hover:bg-brand-yellow hover:text-ink md:px-4 md:py-2 md:text-base",
  focusRing,
].join(" ");
const navPill = [
  "inline-flex items-center justify-center rounded-pill border-2 border-brand-yellow bg-transparent px-3.5 py-1.5 font-body text-sm font-semibold text-brand-yellow transition-colors duration-standard hover:bg-brand-yellow hover:text-ink md:px-4 md:py-2 md:text-base",
  focusRing,
].join(" ");
---

<footer class="site-footer relative z-20 -mt-10 w-full overflow-x-clip md:-mt-12 lg:-mt-14" data-nav-tone="ink">
  <div class="footer-shell relative min-w-0 overflow-x-clip rounded-t-panel md:rounded-t-[2.5rem]">
    <div class="footer-surface-backdrop pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true"></div>

    <div
      class="footer-panel relative z-10 flex w-full flex-col overflow-hidden rounded-t-panel bg-ink text-paper md:rounded-t-[2.5rem]"
    >
      <!-- Yellow Pattern Texture Overlay (same pattern-texture.png as case studies) -->
      <div
        class="footer-pattern-texture pointer-events-none absolute inset-0 z-0 overflow-hidden"
        style={`background-image: url('${patternTexture.src}');`}
        aria-hidden="true"
      ></div>
      <div class="relative z-10 mx-auto w-full max-w-content px-gutter pb-6 pt-9 md:pb-7 md:pt-14 lg:pt-16">
        <div class="footer-layout flex flex-col gap-6 md:gap-7 lg:gap-7">
          <!-- Band 1 — Brand statement + Ready When CTA -->
          <div class="footer-band footer-band--brand items-center text-center lg:items-start lg:text-left">
            <p
              class="footer-headline font-display text-[clamp(3.2rem,9.5vw,7.5rem)] font-black uppercase leading-[0.86] tracking-tight text-paper text-balance"
            >
              Design that keeps
              <span
                class="text-highlight mt-1 block text-[0.52em] font-semibold normal-case leading-[0.95] tracking-normal text-brand-yellow"
              >
                your brand moving.
              </span>
            </p>

            <div class="footer-cta-wrap flex justify-center lg:justify-start w-full">
              <div class="footer-cta-card relative overflow-visible rounded-[1.75rem] border border-brand-yellow/25 bg-[#fafafa] p-5.5 text-ink md:rounded-[2rem] md:p-6.5 text-center lg:text-left w-full max-w-sm lg:max-w-none">
                <FloatingSticker
                  src={starSticker}
                  peel="tr"
                  size="whisper"
                  rotate={14}
                  class="footer-cta-sticker"
                  loading="lazy"
                />

                <p class="font-label text-xs font-bold uppercase tracking-[0.22em] text-ink/75 md:text-sm">
                  Next step
                </p>
                <p
                  class="footer-cta-headline mt-1.5 font-display text-[clamp(1.75rem,2.8vw,2.35rem)] font-black uppercase leading-[0.92] tracking-tight text-balance mx-auto lg:mx-0"
                >
                  Ready when
                  <span
                    class="text-highlight block text-[0.62em] font-semibold normal-case leading-[0.95] tracking-normal text-ink/70"
                  >
                    you are.
                  </span>
                </p>
                <p class="mt-2 max-w-xs font-body text-xs leading-relaxed text-ink/65 md:text-sm lg:text-base mx-auto lg:mx-0">
                  Book a free 15-minute intro and see if Puff fits your next creative priority.
                </p>

                <div class="mt-4 flex justify-center lg:justify-start">
                  <Button href="#book-meeting" variant="primary">
                    Book a Call
                  </Button>
                </div>
              </div>
            </div>
          </div>

          <!-- Band 2 — Nav / legal + centered focus sticker -->
          <div class="footer-band footer-band--utility">
            <div class="footer-utility-left flex flex-col gap-6 md:gap-4 items-center text-center lg:items-start lg:text-left">
              <div class="flex flex-col items-center lg:items-start">
                <p class={sectionLabel}>Navigation</p>
                <ul class="mt-3 lg:mt-2 flex flex-row flex-wrap items-center justify-center lg:justify-start gap-2.5 lg:gap-2">
                  {
                    navLinks.map(({ href, label }) => (
                      <li>
                        <a class={navPill} href={href}>
                          {label}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>

              <div class="flex flex-col items-center lg:items-start mt-2 lg:mt-0">
                <p class={sectionLabel}>Legal</p>
                <ul class="mt-3 lg:mt-2 flex flex-row flex-wrap items-center justify-center lg:justify-start gap-2.5 lg:gap-2">
                  {
                    legalLinks.map(({ href, label }) => (
                      <li>
                        <a class={outlinePill} href={href}>
                          {label}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>

            <div class="footer-focus-zone mt-4 lg:mt-0" aria-hidden="true">
              <Image
                src={focusModeSticker}
                alt=""
                class="footer-focus-sticker"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>

          <!-- Band 3 — Signature + Follow us / Contact -->
          <div class="footer-band footer-band--close">
            <div class="footer-brand flex flex-col items-center text-center lg:items-start lg:text-left w-full lg:w-auto">
              <div class="footer-logo-sticker">
                <svg
                  class="footer-wordmark text-brand-yellow mx-auto lg:mx-0"
                  viewBox="0 0 71.07 24"
                  aria-label="Puff"
                  role="img"
                >
                  <defs>
                    <filter
                      id="footer-puff-sticker-outline"
                      x="-24%"
                      y="-24%"
                      width="148%"
                      height="148%"
                      color-interpolation-filters="sRGB"
                    >
                      <feMorphology in="SourceAlpha" operator="dilate" radius="1.85" result="vinyl-shape"
                      ></feMorphology>
                      <feFlood flood-color="#ffffff" result="vinyl-color"></feFlood>
                      <feComposite
                        in="vinyl-color"
                        in2="vinyl-shape"
                        operator="in"
                        result="vinyl-outline"
                      ></feComposite>

                      <feMorphology in="SourceAlpha" operator="dilate" radius="0.82" result="ink-shape"
                      ></feMorphology>
                      <feFlood flood-color="#1a1a1a" result="ink-color"></feFlood>
                      <feComposite in="ink-color" in2="ink-shape" operator="in" result="ink-outline"
                      ></feComposite>

                      <feMerge>
                        <feMergeNode in="vinyl-outline"></feMergeNode>
                        <feMergeNode in="ink-outline"></feMergeNode>
                        <feMergeNode in="SourceGraphic"></feMergeNode>
                      </feMerge>
                    </filter>
                  </defs>
                  <path
                    fill="currentColor"
                    filter="url(#footer-puff-sticker-outline)"
                    d="M62.03,14.71v.72l-5.71-.78v-5.61l5.71-.79v1.83h7.17v4.66l-7.17-.03ZM62.03,16.07l-5.71-.94v4.43l5.71,2.01v-5.5ZM44.73,22.69h1.15v-7.72h7.17v-.08l-12.88-2.11v4.6l4.56,5.31ZM51.58,1.03h-11.85v8.08L51.58,1.03ZM18.86,11.17v1.3c-.09,2.18.32,4.35,1.18,6.36l5.12-2.09c-.46-1.15-.66-2.39-.59-3.63v-1.6l-5.71-.35ZM37.29,7.58V1.24h-3.54l3.54,6.34ZM40.37,12.13l12.88,1.76v-4.2h-7.15v-4.02h7.49l.91-.33V1.01h-.79l-13.29,8.13-.04,2.99ZM56.31,8.59l5.71-1.01v-1.72h8.37V1.19h-1.56l-12.5,3.95v3.45ZM55.74,4.63l9.75-3.58h-9.73v3.58ZM6.47,21.81l-2.73.88h2.74v-.88ZM19.32,10.68l5.71.51v-4.47l-5.71-2.7v6.66ZM33.14,1.58h-1.33v11.53c0,3.76-1.06,5.12-3.33,5.12-.51.05-1.03-.05-1.49-.28-.46-.23-.84-.59-1.09-1.02l-4.98,2.28c1.41,2.57,3.93,3.8,7.59,3.8h.57l2.44-3.47-2.11,3.45c5.42-.33,7.93-3.71,7.93-10.53v-4.41l-4.19-6.47ZM55.91,20.02v2.51h5.71v-.19l-5.71-2.32ZM24.91,6.24V1.18h-5.71v2.01l5.71,3.05ZM39.77,17.29v5.2h3.89l-3.89-5.2ZM.43,8.79l5.71.51v-3.74h1.93c2.19,0,3.45.72,3.45,2.6.02.55-.11,1.1-.36,1.6l5.67.51c.18-.69.26-1.4.26-2.11.01-.88-.12-1.76-.39-2.6L2.04,1.16H.38l.05,7.64ZM6.54,15.73h2.33c1.67.03,3.32-.33,4.82-1.03l-12.86,1.83v5.85h.26l5.45-1.53v-5.12ZM17.1,5.41C15.97,2.12,12.57,1,8.73,1h-3.62l11.99,4.41ZM16.75,10.78l-5.89-.39c-.35.34-.77.6-1.23.76-.46.16-.95.22-1.44.18h-2.06v-1.24l-5.71-.38v5.85l13.33-1.11c1.41-.82,2.46-2.12,2.95-3.65l.05-.02Z"
                  ></path>
                </svg>
              </div>

              <p
                class="mt-4 lg:mt-2 font-label text-[0.7rem] font-bold uppercase tracking-[0.18em] text-paper/55 md:mt-2"
              >
                © {new Date().getFullYear()} Puff Cross Media. All rights reserved.
              </p>
            </div>

            <div class="footer-utility-right flex flex-col items-center text-center lg:items-start lg:text-left mt-6 lg:mt-0 w-full lg:w-auto">
              <p class={sectionLabel}>Follow us</p>
              <ul class="mt-3 lg:mt-2 flex items-center justify-center lg:justify-start gap-2.5">
                {
                  socialLinks.map(({ href, label, platform }) => (
                    <li>
                      <a
                        class:list={[
                          "footer-social-3d btn-3d-skeuo-yellow grid size-10 place-items-center rounded-full text-ink md:size-11",
                          focusRing,
                        ]}
                        aria-label={label}
                        href={href}
                      >
                        {platform === "instagram" ? (
                          <svg aria-hidden="true" class="size-4 md:size-5" fill="none" viewBox="0 0 18 18">
                            <rect
                              height="12.5"
                              rx="3.25"
                              stroke="currentColor"
                              stroke-width="1.5"
                              width="12.5"
                              x="2.75"
                              y="2.75"
                            />
                            <circle cx="9" cy="9" r="3" stroke="currentColor" stroke-width="1.5" />
                            <circle cx="13.1" cy="4.9" fill="currentColor" r="0.75" />
                          </svg>
                        ) : (
                          <svg aria-hidden="true" class="size-4 md:size-5" fill="currentColor" viewBox="0 0 18 18">
                            <path d="M10.2 9.6H12.3L13.1 6.8H10.2V5.1C10.2 4.4 10.4 3.9 11.5 3.9H13.2V1.4C12.9 1.4 11.9 1.2 10.8 1.2C8.5 1.2 7 2.5 7 4.8V6.8H4.5V9.6H7V16.8H10.2V9.6Z" />
                          </svg>
                        )}
                      </a>
                    </li>
                  ))
                }
              </ul>

              <p class={`${sectionLabel} mt-5 lg:mt-3`}>Contact</p>
              <p class="mt-2 lg:mt-1 max-w-xs font-body text-xs leading-relaxed text-paper/60 md:text-sm mx-auto lg:mx-0">
                Design on demand, no hassle. Book your free intro below.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  import { syncFooterSurface } from "../../scripts/footer-surface";

  function initFooterSurface() {
    syncFooterSurface();
    requestAnimationFrame(() => syncFooterSurface());
  }

  document.addEventListener("astro:page-load", initFooterSurface);
  window.addEventListener("resize", initFooterSurface);
</script>

