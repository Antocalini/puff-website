---
import type { NavigationItem } from "../../content/landing";
import { landingContent } from "../../content/landing";
import logoPuff from "../../assets/images/logo-puff-completo.svg";

type Props = {
  items: readonly NavigationItem[];
};

const { items } = Astro.props;
const { brandName } = landingContent.header.value;
const primaryCta = landingContent.hero.value.primaryCta;

const navLinkClass =
  "nav-pill-link whitespace-nowrap rounded-pill px-3.5 py-2 text-[0.8125rem] font-medium tracking-tight transition-colors duration-standard ease-out hover:bg-charcoal/8";

const mobilePanelLinkClass =
  "nav-mobile-panel-link nav-pill-link block rounded-pill px-3.5 py-2.5 text-[0.9375rem] font-semibold tracking-tight transition-colors duration-standard ease-out hover:bg-charcoal/8";
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50" data-site-header>
  <div class="pointer-events-none mx-auto flex w-full max-w-content justify-center px-gutter py-3 md:py-5">
    <!-- Desktop / tablet smart pill -->
    <nav
      class="nav-pill-3d pointer-events-auto relative hidden items-center rounded-full md:flex"
      data-nav-pill
      aria-label="Primary navigation"
    >
      <a class="nav-pill-logo-link relative z-10 shrink-0" href="/" data-nav-logo>
        <img
          src={logoPuff.src}
          alt={brandName}
          class="nav-pill-logo"
          width={73}
          height={35}
          decoding="async"
        />
      </a>

      <div class="nav-pill-collapse" data-nav-collapse>
        <div class="nav-pill-collapse-inner">
          <div class="nav-pill-collapse-content flex items-center gap-1">
            <ul class="flex items-center">
              {
                items.map(({ href, label }) => (
                  <li>
                    <a class={navLinkClass} href={href}>
                      {label}
                    </a>
                  </li>
                ))
              }
            </ul>

            <a
              class="group btn-3d-skeuo btn-shine nav-pill-cta ml-1 inline-flex shrink-0 items-center justify-center gap-2 rounded-full py-2 pl-4 pr-2"
              href={primaryCta.href}
              data-nav-cta
            >
              <span class="nav-pill-cta-label font-label text-xs font-bold tracking-wide">
                {primaryCta.label}
              </span>
              <div class="nav-pill-cta-arrow flex size-7 shrink-0 items-center justify-center rounded-full shadow-sm">
                <svg class="size-3.5 stroke-[2.5]" fill="none" viewBox="0 0 16 16" aria-hidden="true">
                  <path
                    d="M3 8h9M8 3.5 12.5 8 8 12.5"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </div>
            </a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Mobile: smart pill — logo left + menu right; panel sits outside overflow:hidden -->
    <div class="pointer-events-auto relative w-full md:hidden" data-mobile-nav-shell>
      <nav
        class="nav-pill-3d relative flex min-w-0 items-center rounded-full"
        data-nav-pill-mobile
        aria-label="Primary navigation"
      >
        <a class="nav-pill-logo-link relative z-10 shrink-0" href="/" data-nav-logo-mobile>
          <img
            src={logoPuff.src}
            alt={brandName}
            class="nav-pill-logo nav-pill-logo--mobile"
            width={73}
            height={35}
            decoding="async"
          />
        </a>

        <div class="nav-pill-collapse nav-pill-collapse--mobile" data-nav-collapse-mobile>
          <div class="nav-pill-collapse-inner">
            <div class="nav-pill-collapse-content flex items-center justify-end">
              <button
                type="button"
                class="nav-mobile-menu-btn grid size-9 shrink-0 cursor-pointer place-items-center rounded-full"
                aria-label="Open menu"
                aria-expanded="false"
                aria-controls="mobile-nav-panel"
                data-mobile-nav-toggle
              >
                <svg aria-hidden="true" class="nav-mobile-menu-icon size-4" fill="none" viewBox="0 0 18 18">
                  <path d="M3.5 5.25H14.5" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" />
                  <path d="M3.5 9H14.5" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" />
                  <path d="M3.5 12.75H14.5" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      </nav>

      <div
        id="mobile-nav-panel"
        class="nav-mobile-panel nav-pill-3d absolute left-1/2 top-[calc(100%+0.75rem)] z-30 hidden w-[min(18rem,calc(100vw-2rem))] -translate-x-1/2 rounded-[1.75rem] p-3"
        data-mobile-nav-panel
        hidden
      >
        <nav aria-label="Mobile navigation">
          <ul class="flex flex-col gap-1">
            {
              items.map(({ href, label }) => (
                <li>
                  <a class={mobilePanelLinkClass} href={href} data-mobile-nav-link>
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <a
          class="group btn-shine nav-mobile-panel-cta mt-3 inline-flex w-full items-center justify-center gap-2 rounded-full py-2.5 pl-4 pr-2"
          href={primaryCta.href}
          data-mobile-nav-link
        >
          <span class="nav-pill-cta-label font-label text-xs font-bold tracking-wide">
            {primaryCta.label}
          </span>
          <div class="nav-pill-cta-arrow flex size-7 shrink-0 items-center justify-center rounded-full shadow-sm">
            <svg class="size-3.5 stroke-[2.5]" fill="none" viewBox="0 0 16 16" aria-hidden="true">
              <path
                d="M3 8h9M8 3.5 12.5 8 8 12.5"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  import { bootSmartNav } from "../../scripts/smart-nav";

  bootSmartNav();
</script>
