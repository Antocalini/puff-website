---
import { Image } from "astro:assets";
import PuffSticker from "../ui/PuffSticker.astro";
import graphicMascot from "../../assets/images/stickers/graphic-mascot.webp";
import webMascot from "../../assets/images/stickers/web-mascot.webp";
import mascot3d from "../../assets/images/stickers/3d-mascot.webp";
import clickMascot from "../../assets/images/stickers/click-mascot.webp";
import voiceMascot from "../../assets/images/stickers/voice-mascot.webp";
import type { ImageMetadata } from "astro";

type ServiceIcon = "image" | "layout" | "cube" | "grid" | "photo";

type ServiceCard = {
  num: string;
  category: string;
  title: string;
  description: string;
  cols: string;
  minHeight: string;
  bgClass: string;
  pillClass: string;
  mascot: ImageMetadata;
  mascotClass: string;
  mascotPositionClass?: string;
  titleWrapClass?: string;
  titleClass?: string;
  contentClass?: string;
  imgLabel: string;
  icon: ServiceIcon;
};

const services: ServiceCard[] = [
  {
    num: "01",
    category: "BRANDING",
    title: "BRAND IDENTITY & ART DIRECTION",
    description:
      "Typography systems, color strategy, and complete visual guidelines.",
    cols: "lg:col-span-6",
    minHeight: "min-h-[14.5rem] md:min-h-[20rem]",
    bgClass: "bg-[#2447F5] text-white",
    pillClass: "bg-black/25 text-white",
    mascot: graphicMascot,
    mascotClass: "h-[68%] w-[48%] max-w-none md:h-[92%] md:w-[66%]",
    mascotPositionClass: "translate-x-[14%] md:translate-x-[3%]",
    titleWrapClass: "max-w-none",
    titleClass: "text-2xl md:text-[1.9rem] lg:text-[2.2rem] xl:text-[2.45rem] leading-[0.9]",
    contentClass: "pr-[34%] sm:pr-[30%] md:pr-[32%]",
    imgLabel: "Brand Guidelines & Logo Mockups",
    icon: "image",
  },
  {
    num: "02",
    category: "WEB DESIGN",
    title: "MODERN & BESPOKE WEBSITES",
    description: "Custom code, sub-second load times, and interactive responsive layouts.",
    cols: "lg:col-span-6",
    minHeight: "min-h-[14.5rem] md:min-h-[20rem]",
    bgClass: "bg-brand-yellow text-charcoal",
    pillClass: "bg-black/10 text-charcoal",
    mascot: webMascot,
    mascotClass: "h-[68%] w-[50%] max-w-none md:h-[94%] md:w-[68%]",
    mascotPositionClass: "translate-x-[14%] md:translate-x-[3%]",
    titleWrapClass: "max-w-none",
    titleClass: "text-2xl md:text-[1.9rem] lg:text-[2.2rem] xl:text-[2.45rem] leading-[0.9]",
    contentClass: "pr-[34%] sm:pr-[30%] md:pr-[32%]",
    imgLabel: "Digital Product & Web UI Preview",
    icon: "layout",
  },
  {
    num: "03",
    category: "PACKAGING & MERCH",
    title: "CUSTOM PACKAGING & MERCH",
    description:
      "Structural boxes, product labels, tissue wraps, and physical unboxing experiences.",
    cols: "lg:col-span-4",
    minHeight: "min-h-[13rem] md:min-h-[18rem]",
    bgClass: "bg-accent-pink text-charcoal",
    pillClass: "bg-black/10 text-charcoal",
    mascot: mascot3d,
    mascotClass: "h-[58%] max-w-[46%] md:h-[78%] md:max-w-[58%]",
    mascotPositionClass: "translate-x-[18%] translate-y-[6%] md:translate-x-[7%] md:translate-y-0",
    imgLabel: "Packaging & Physical Merch",
    icon: "cube",
  },
  {
    num: "04",
    category: "PRINT & COLLATERAL",
    title: "PRINT & SPATIAL COLLATERAL",
    description:
      "Storefront signage, menus, tactile stationery, and marketing collaterals.",
    cols: "lg:col-span-4",
    minHeight: "min-h-[13rem] md:min-h-[18rem]",
    bgClass: "bg-accent-lime text-charcoal",
    pillClass: "bg-black/10 text-charcoal",
    mascot: clickMascot,
    mascotClass: "h-[56%] max-w-[48%] md:h-[76%] md:max-w-[60%]",
    mascotPositionClass: "translate-x-[18%] md:translate-x-[7%]",
    imgLabel: "Print & Environmental Collateral",
    icon: "grid",
  },
  {
    num: "05",
    category: "CAMPAIGNS",
    title: "HIGH-VELOCITY CREATIVE CONTENT",
    description: "Performance ad creatives and promotional design at scale.",
    cols: "lg:col-span-4",
    minHeight: "min-h-[13rem] md:min-h-[18rem]",
    bgClass: "bg-[#FF5500] text-black",
    pillClass: "bg-black text-white",
    mascot: voiceMascot,
    mascotClass: "h-[58%] max-w-[46%] md:h-[80%] md:max-w-[58%]",
    mascotPositionClass: "translate-x-[18%] md:translate-x-[7%]",
    imgLabel: "Social Assets & Ad Creatives",
    icon: "photo",
  },
];
---

<section
  id="services"
  data-nav-tone="ink"
  class="relative z-10 w-full scroll-mt-6 overflow-hidden bg-ink py-24 text-paper md:py-36"
>
  <div class="mx-auto w-full max-w-content px-gutter">
    <div
      class="flex flex-col gap-6 border-b border-white/15 pb-8 md:flex-row md:items-end md:justify-between md:pb-12"
    >
      <div>
        <PuffSticker tone="lime" rotate="-rotate-[6deg]">
          Capabilities & Services
        </PuffSticker>
        <h2
          class="mt-4 font-display text-[clamp(3.25rem,8vw,6.75rem)] font-black uppercase leading-[0.86] tracking-tight text-brand-yellow"
        >
          What We Do Best
        </h2>
      </div>

      <p
        class="max-w-lg font-body font-medium text-base leading-relaxed text-paper md:pb-1 md:text-lg lg:text-xl"
      >
        Full-stack creative execution delivered through a seamless subscription
        model. Design, code, motion, and brand strategy under one roof.
      </p>
    </div>

    <div class="mt-10 grid gap-5 md:mt-14 md:gap-6 lg:grid-cols-12">
      {
        services.map((item) => (
          <article
            class:list={[
              "group relative flex flex-col overflow-hidden rounded-[1.75rem] border-2 border-black p-5 transition-transform duration-300 hover:scale-[1.01] md:p-6",
              item.cols,
              item.minHeight,
              item.bgClass,
            ]}
          >
            <div class="relative z-10 flex items-start justify-between border-b border-current/15 pb-3">
              <span class="font-display text-3xl font-black md:text-4xl">
                {item.num}
              </span>
              <span class="font-label text-[0.65rem] font-bold uppercase tracking-[0.16em]">
                {item.category}
              </span>
            </div>

            <div
              class:list={[
                "relative z-10 mt-4 flex flex-1 flex-col pr-[42%] sm:pr-[42%] md:pr-[44%]",
                item.contentClass,
              ]}
            >
              <div
                class:list={[
                  "max-w-[18rem] md:max-w-[20rem]",
                  item.titleWrapClass,
                ]}
              >
                <h3
                  class:list={[
                    "font-display text-xl font-black uppercase leading-[0.92] tracking-tight md:text-2xl lg:text-[1.65rem]",
                    item.titleClass,
                  ]}
                >
                  {item.title}
                </h3>
                <p class="mt-2 font-body font-medium text-[0.78rem] leading-relaxed md:text-sm">
                  {item.description}
                </p>
            </div>
            </div>

            <Image
              src={item.mascot}
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
              class:list={[
                "pointer-events-none absolute bottom-0 right-0 z-0 w-auto object-contain object-bottom-right transition-transform duration-500 group-hover:scale-[1.03]",
                item.mascotClass,
                item.mascotPositionClass,
              ]}
            />
          </article>
        ))
      }
    </div>
  </div>
</section>
