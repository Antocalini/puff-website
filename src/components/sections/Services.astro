---
import { Image } from "astro:assets";
import PuffSticker from "../ui/PuffSticker.astro";
import graphicMascot from "../../assets/images/stickers/graphic-mascot.webp";
import webMascot from "../../assets/images/stickers/web-mascot.webp";
import mascot3d from "../../assets/images/stickers/3d-mascot.webp";
import clickMascot from "../../assets/images/stickers/click-mascot.webp";
import voiceMascot from "../../assets/images/stickers/voice-mascot.webp";
import type { ImageMetadata } from "astro";

type ServiceIcon = "image" | "layout" | "cube" | "grid" | "photo";

type ServiceCard = {
  num: string;
  category: string;
  title: string;
  description: string;
  cols: string;
  minHeight: string;
  bgClass: string;
  pillClass: string;
  mascot: ImageMetadata;
  mascotClass: string;
  mascotPositionClass?: string;
  titleWrapClass?: string;
  titleClass?: string;
  contentClass?: string;
  imgLabel: string;
  icon: ServiceIcon;
};

const services: ServiceCard[] = [
  {
    num: "01",
    category: "BRANDING",
    title: "BRAND IDENTITY & ART DIRECTION",
    description:
      "Typography systems, color strategy, and complete visual guidelines.",
    cols: "lg:col-span-6",
    minHeight: "min-h-[14.5rem] md:min-h-[20rem]",
    bgClass: "bg-[#2447F5] text-white",
    pillClass: "bg-black/25 text-white",
    mascot: graphicMascot,
    mascotClass: "h-[68%] w-[48%] max-w-none md:h-[92%] md:w-[66%]",
    mascotPositionClass: "translate-x-[14%] md:translate-x-[3%]",
    titleWrapClass: "max-w-none",
    titleClass: "text-2xl md:text-[1.9rem] lg:text-[2.2rem] xl:text-[2.45rem] leading-[0.9]",
    contentClass: "pr-[34%] sm:pr-[30%] md:pr-[32%]",
    imgLabel: "Brand Guidelines & Logo Mockups",
    icon: "image",
  },
  {
    num: "02",
    category: "WEB DESIGN",
    title: "HIGH-CONVERSION WEBSITES",
    description: "Custom code, sub-second load times, and responsive layouts.",
    cols: "lg:col-span-6",
    minHeight: "min-h-[14.5rem] md:min-h-[20rem]",
    bgClass: "bg-brand-yellow text-charcoal",
    pillClass: "bg-black/10 text-charcoal",
    mascot: webMascot,
    mascotClass: "h-[68%] w-[50%] max-w-none md:h-[94%] md:w-[68%]",
    mascotPositionClass: "translate-x-[14%] md:translate-x-[3%]",
    titleWrapClass: "max-w-none",
    titleClass: "text-2xl md:text-[1.9rem] lg:text-[2.2rem] xl:text-[2.45rem] leading-[0.9]",
    contentClass: "pr-[34%] sm:pr-[30%] md:pr-[32%]",
    imgLabel: "Digital Product & Web UI Preview",
    icon: "layout",
  },
  {
    num: "03",
    category: "MOTION & 3D",
    title: "60FPS MOTION & 3D VISUALS",
    description:
      "Fluid micro-interactions and 3D renders that bring pages to life.",
    cols: "lg:col-span-4",
    minHeight: "min-h-[13rem] md:min-h-[18rem]",
    bgClass: "bg-accent-pink text-charcoal",
    pillClass: "bg-black/10 text-charcoal",
    mascot: mascot3d,
    mascotClass: "h-[58%] max-w-[46%] md:h-[78%] md:max-w-[58%]",
    mascotPositionClass: "translate-x-[18%] translate-y-[6%] md:translate-x-[7%] md:translate-y-0",
    imgLabel: "3D Renders & Motion Frames",
    icon: "cube",
  },
  {
    num: "04",
    category: "UI SYSTEMS",
    title: "SCALABLE COMPONENT LIBRARIES",
    description:
      "Production-ready Figma and code tokens engineered for velocity.",
    cols: "lg:col-span-4",
    minHeight: "min-h-[13rem] md:min-h-[18rem]",
    bgClass: "bg-accent-lime text-charcoal",
    pillClass: "bg-black/10 text-charcoal",
    mascot: clickMascot,
    mascotClass: "h-[56%] max-w-[48%] md:h-[76%] md:max-w-[60%]",
    mascotPositionClass: "translate-x-[18%] md:translate-x-[7%]",
    imgLabel: "Design Tokens & UI Component Kit",
    icon: "grid",
  },
  {
    num: "05",
    category: "CAMPAIGNS",
    title: "HIGH-VELOCITY CREATIVE CONTENT",
    description: "Performance ad creatives and promotional design at scale.",
    cols: "lg:col-span-4",
    minHeight: "min-h-[13rem] md:min-h-[18rem]",
    bgClass: "bg-[#FF5500] text-white",
    pillClass: "bg-black/25 text-white",
    mascot: voiceMascot,
    mascotClass: "h-[58%] max-w-[46%] md:h-[80%] md:max-w-[58%]",
    mascotPositionClass: "translate-x-[18%] md:translate-x-[7%]",
    imgLabel: "Social Assets & Ad Creatives",
    icon: "photo",
  },
];
---

<section
  id="services"
  data-nav-tone="ink"
  class="relative z-10 w-full scroll-mt-6 overflow-hidden bg-ink py-12 text-paper md:py-16"
>
  <div class="mx-auto w-full max-w-content px-gutter">
    <div
      class="flex flex-col gap-4 border-b border-white/15 pb-6 md:flex-row md:items-end md:justify-between md:pb-8"
    >
      <div>
        <PuffSticker tone="lime" rotate="-rotate-[6deg]">
          Capabilities & Services
        </PuffSticker>
        <h2
          class="mt-4 font-display text-[clamp(2.5rem,5.5vw,5rem)] font-black uppercase leading-[0.88] tracking-tight text-brand-yellow"
        >
          What We Do Best
        </h2>
      </div>

      <p
        class="max-w-md font-body text-sm leading-relaxed text-paper md:pb-1 md:text-base"
      >
        Full-stack creative execution delivered through a seamless subscription
        model. Design, code, motion, and brand strategy under one roof.
      </p>
    </div>

    <div class="mt-6 grid gap-4 md:mt-8 lg:grid-cols-12">
      {
        services.map((item) => (
          <article
            class:list={[
              "group relative flex flex-col overflow-hidden rounded-[1.75rem] border-2 border-black p-5 transition-transform duration-300 hover:scale-[1.01] md:p-6",
              item.cols,
              item.minHeight,
              item.bgClass,
            ]}
          >
            <div class="relative z-10 flex items-start justify-between border-b border-current/15 pb-3">
              <span class="font-display text-3xl font-black opacity-35 md:text-4xl">
                {item.num}
              </span>
              <span class="font-label text-[0.65rem] font-bold uppercase tracking-[0.16em] opacity-80">
                {item.category}
              </span>
            </div>

            <div
              class:list={[
                "relative z-10 mt-4 flex flex-1 flex-col pr-[42%] sm:pr-[42%] md:pr-[44%]",
                item.contentClass,
              ]}
            >
              <div
                class:list={[
                  "max-w-[18rem] md:max-w-[20rem]",
                  item.titleWrapClass,
                ]}
              >
                <h3
                  class:list={[
                    "font-display text-xl font-black uppercase leading-[0.92] tracking-tight md:text-2xl lg:text-[1.65rem]",
                    item.titleClass,
                  ]}
                >
                  {item.title}
                </h3>
                <p class="mt-2 font-body text-[0.78rem] leading-relaxed opacity-85 md:text-sm">
                  {item.description}
                </p>
              </div>

              <div
                class:list={[
                  "mt-auto inline-flex w-fit max-w-full items-center gap-2 rounded-full px-3 py-2 font-label text-[0.58rem] font-bold uppercase tracking-[0.12em] md:text-[0.62rem]",
                  item.pillClass,
                ]}
              >
                {
                  item.icon === "image" && (
                    <svg
                      class="size-3.5 shrink-0"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                      />
                    </svg>
                  )
                }
                {
                  item.icon === "layout" && (
                    <svg
                      class="size-3.5 shrink-0"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"
                      />
                    </svg>
                  )
                }
                {
                  item.icon === "cube" && (
                    <svg
                      class="size-3.5 shrink-0"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-14.25v9"
                      />
                    </svg>
                  )
                }
                {
                  item.icon === "grid" && (
                    <svg
                      class="size-3.5 shrink-0"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"
                      />
                    </svg>
                  )
                }
                {
                  item.icon === "photo" && (
                    <svg
                      class="size-3.5 shrink-0"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z"
                      />
                    </svg>
                  )
                }
                <span class="truncate">{item.imgLabel}</span>
              </div>
            </div>

            <Image
              src={item.mascot}
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
              class:list={[
                "pointer-events-none absolute bottom-0 right-0 z-0 w-auto object-contain object-bottom-right transition-transform duration-500 group-hover:scale-[1.03]",
                item.mascotClass,
                item.mascotPositionClass,
              ]}
            />
          </article>
        ))
      }
    </div>
  </div>
</section>
