---
import { landingContent } from "../../content/landing";
import PuffSticker from "../ui/PuffSticker.astro";
import faqLoop from "../../assets/images/faq.webm";
import "../../styles/sections/faq.css";

const { heading, items } = landingContent.faq.value;
---

<section
  id="faq"
  data-nav-tone="yellow"
  class="relative w-full bg-brand-yellow flex flex-col pt-24 pb-12"
>
  
  <!-- Header Area -->
  <div class="w-full max-w-screen-2xl mx-auto px-gutter relative z-20 flex flex-col items-center justify-center pt-8 md:pt-16 pb-8 md:pb-16 min-h-[150px] md:min-h-[300px]">
    
    <div class="absolute left-1/2 top-0 z-30 -translate-x-[115%] transition-transform duration-500 ease-out hover:scale-110 md:left-12 md:top-[22%] md:translate-x-0 lg:left-32" aria-hidden="true">
      <PuffSticker tone="lime" rotate="-rotate-[8deg]" class="faq-header-sticker">
        Questions
      </PuffSticker>
    </div>

    <div class="absolute left-1/2 top-0 z-30 translate-x-[15%] transition-transform duration-500 ease-out hover:scale-110 md:left-auto md:right-12 md:top-[62%] md:translate-x-0 lg:right-32" aria-hidden="true">
      <PuffSticker tone="lavender" rotate="rotate-[9deg]" class="faq-header-sticker">
        Information
      </PuffSticker>
    </div>

    <!-- Título FAQ -->
    <h2 class="font-display text-[clamp(3.5rem,18vw,10rem)] font-black uppercase text-ink leading-none tracking-normal text-center w-full select-none relative z-10 px-2 md:px-4 mt-10 md:mt-0">
      {heading}
    </h2>
  </div>

  <!-- Centered FAQ; mascot overlays bottom-right of the tiles -->
  <div class="faq-layout w-full max-w-6xl mx-auto px-4 md:px-8 lg:px-12 relative z-10 pb-16 md:pb-24">

    <div class="faq-container flex flex-col">
      {items.map((item) => (
        <div class="faq-item group border-b border-ink/25 last:border-b-0 cursor-pointer">
          <div class="faq-trigger flex items-center justify-center py-6 md:py-9 px-2 md:px-4 transition-colors duration-500 hover:bg-ink/5 group-[.is-active]:hover:bg-transparent w-full text-center rounded-[inherit]">
            <div class="faq-trigger-row">
            <div class="faq-trigger-icon flex-shrink-0 flex items-center text-ink group-[.is-active]:text-brand-yellow transition-colors transition-transform duration-500 ease-[cubic-bezier(0.65,0,0.35,1)] group-[.is-active]:rotate-90">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 md:w-7 md:h-7">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </div>
            
            <h3 class="faq-trigger-question font-body text-2xl md:text-4xl lg:text-[2.5rem] font-bold tracking-normal text-ink group-[.is-active]:text-brand-yellow transition-colors duration-500 leading-tight">
              {item.question}
            </h3>
              
            <div class="faq-trigger-icon w-6 h-6 md:w-8 md:h-8 flex-shrink-0 flex items-center justify-center text-ink group-[.is-active]:text-brand-yellow transition-colors transition-transform duration-500 ease-[cubic-bezier(0.65,0,0.35,1)] group-[.is-active]:rotate-90">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-full h-full">
                <path d="M12 0C12 6.627 17.373 12 24 12C17.373 12 12 17.373 12 24C12 17.373 6.627 12 0 12C6.627 12 12 6.627 12 0Z"></path>
              </svg>
            </div>
            </div>

          </div>
          
          <div class="faq-content-wrapper">
            <div class="faq-content">
              <div class="pb-6 pt-2 text-center md:pb-8">
                <p class="font-body text-ink/80 group-[.is-active]:text-brand-yellow text-base md:text-xl leading-relaxed max-w-xl mx-auto transition-colors duration-500">
                  {item.answer}
                </p>
              </div>
            </div>
          </div>
        </div>
      ))}

      <!-- Overlay — bottom-right of FAQ tiles, no layout space -->
      <div class="faq-media" aria-hidden="true">
        <video
          data-faq-loop
          src={faqLoop}
          autoplay
          muted
          loop
          playsinline
          preload="auto"
        ></video>
      </div>
    </div>

  </div>
</section>

<script>
  import { initFaq } from "../../scripts/faq-accordion";

  initFaq();
  document.addEventListener("astro:page-load", initFaq);
</script>
