---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { landingContent } from "../../content/landing";
import TrustedByMarquee from "../ui/TrustedByMarquee.astro";
import workSticker from "../../assets/images/stickers/work.webp";
import cloudSticker from "../../assets/images/stickers/cloud.webp";
import numberOneSticker from "../../assets/images/stickers/number-one.webp";

const { body, primaryCta } = landingContent.hero.value;

type HeroSticker = {
  src: ImageMetadata;
  peel: "tl" | "tr" | "bl";
  size: "sm" | "md" | "lg";
  pos: "work" | "cloud" | "one";
};

/** Sit at the edges, z below the headline so copy stays readable. */
const heroStickers: HeroSticker[] = [
  {
    src: workSticker,
    peel: "tl",
    size: "md",
    pos: "work",
  },
  {
    src: cloudSticker,
    peel: "tr",
    size: "lg",
    pos: "cloud",
  },
  {
    src: numberOneSticker,
    peel: "bl",
    size: "sm",
    pos: "one",
  },
];
---

<section
  data-nav-tone="yellow"
  class="pointer-events-none relative z-20 min-h-dvh overflow-hidden bg-transparent text-charcoal"
>

  <div
    class="hero-shell pointer-events-none relative z-10 mx-auto flex min-h-dvh max-w-content flex-col items-center justify-center px-gutter text-center md:pb-24 md:pt-36"
  >
    <div class="hero-title-wrap relative z-20 mx-auto w-full">
      <!-- Hero peek: tiny 9:16 on mobile only → landscape on desktop -->
      <span
        data-media-origin
        class="pointer-events-none absolute left-1/2 top-[57%] z-[15] aspect-[9/16] w-[min(10.5vw,2.75rem)] -translate-x-1/2 -translate-y-1/2 md:top-[46%] md:z-20 md:aspect-16/10 md:w-[min(32vw,17.5rem)]"
        aria-hidden="true"
      >
        <div
          data-hero-media
          data-media-tilted
          class="hero-media h-full w-full overflow-hidden rounded-[0.65rem] border-[0.2rem] border-accent-pink bg-charcoal md:rounded-[1.25rem] md:border-[0.4rem]"
        >
          <div class="relative h-full w-full">
            <div class="absolute inset-0 bg-[linear-gradient(160deg,#ffd100_0%,#f091f2_42%,#2447f5_100%)]"></div>
            <div class="absolute inset-1 rounded-[0.35rem] border border-paper/35 md:inset-3.5 md:rounded-[0.85rem]"></div>
            <p class="absolute bottom-1 left-1 z-[6] font-label text-[0.32rem] font-bold uppercase tracking-[0.1em] text-ink md:bottom-5 md:left-5 md:text-[0.72rem] md:tracking-[0.18em]">
              Sample / Draft
            </p>
          </div>
        </div>
      </span>

      <h1
        class="hero-title relative w-full font-display font-black uppercase leading-[0.72] tracking-tight text-charcoal md:font-normal md:leading-[0.82] md:tracking-[0.01em]"
      >
        <span class="relative z-10 block whitespace-nowrap">Get to know</span>
        <span class="relative z-30 mt-1 block whitespace-nowrap md:mt-2">your design</span>
      </h1>
    </div>

    {
      heroStickers.map((sticker) => (
        <div
          class:list={[
            "hero-sticker-wrap pointer-events-auto absolute z-[8]",
            `hero-sticker-wrap--peel-${sticker.peel}`,
            `hero-sticker-pos--${sticker.pos}`,
            sticker.size === "sm" && "hero-sticker-wrap--size-sm",
            sticker.size === "md" && "hero-sticker-wrap--size-md",
          ]}
          aria-hidden="true"
        >
          <Image
            src={sticker.src}
            alt=""
            class="hero-sticker"
            widths={[120, 180, 240, 320, 480]}
            sizes="(max-width: 767px) 42vw, (max-width: 1023px) 18vw, 300px"
            loading="eager"
            decoding="async"
          />
        </div>
      ))
    }

    <p class="relative z-[12] mt-8 max-w-[20rem] text-pretty text-[1.05rem] leading-relaxed text-charcoal/85 md:mt-12 md:max-w-2xl md:text-[1.35rem]">
      {body}
    </p>

    <a
      class="group btn-3d-skeuo btn-shine pointer-events-auto relative z-[12] mt-8 inline-flex min-h-16 items-center justify-center gap-4 rounded-full px-9 py-4 text-paper md:mt-12"
      href={primaryCta.href}
    >
      <span class="font-label text-sm md:text-base font-bold tracking-wide">
        {primaryCta.label}
      </span>
      <div class="flex size-9 items-center justify-center rounded-full bg-paper/15 text-paper transition-all duration-300 group-hover:translate-x-1 group-hover:bg-brand-yellow group-hover:text-charcoal shadow-sm">
        <svg class="size-4 stroke-[2.5]" fill="none" viewBox="0 0 16 16">
          <path d="M3 8h9M8 3.5 12.5 8 8 12.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
    </a>

    <TrustedByMarquee class="pointer-events-none relative z-[12] mt-6 md:mt-10" />
  </div>
</section>

<style>
  /* Mobile: true vertical center in viewport (nav offset balanced) */
  .hero-shell {
    padding-top: max(5.25rem, 11dvh);
    padding-bottom: max(3.25rem, 7dvh);
  }

  .hero-title-wrap {
    container-type: inline-size;
    width: 100vw;
    max-width: 100vw;
    margin-inline: calc(50% - 50vw);
    padding-inline: var(--spacing-gutter);
  }

  .hero-title {
    width: 100%;
    font-size: clamp(5.25rem, 25.5cqi, 18rem);
    letter-spacing: -0.02em;
  }

  @media (min-width: 768px) {
    .hero-shell {
      padding-top: 9rem;
      padding-bottom: 6rem;
    }

    .hero-title-wrap {
      container-type: normal;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      max-width: none;
      margin-inline: 0;
      padding-inline: 0;
    }

    .hero-title {
      width: auto;
      font-size: clamp(4.5rem, 13.5vw, 11.5rem);
      letter-spacing: 0.01em;
      line-height: 0.82;
    }
  }

  .hero-media {
    box-shadow: var(--shadow-ambient);
  }

  .hero-media[data-media-flying] {
    box-shadow: none;
  }

  .hero-media[data-media-tilted] {
    transform: rotate(-4deg);
  }

  @media (min-width: 768px) {
    .hero-media[data-media-tilted]:not([data-media-flying]) {
      animation: hero-media-float 6.5s ease-in-out infinite;
    }
  }

  @keyframes hero-media-float {
    0%,
    100% {
      transform: rotate(-4deg) translate3d(0, 0, 0);
    }

    50% {
      transform: rotate(-4deg) translate3d(0, -0.75rem, 0);
    }
  }

  .hero-sticker {
    display: block;
    width: min(42vw, 11.5rem);
    height: auto;
    filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.16));
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
    animation: hero-sticker-rock 8.5s ease-in-out infinite;
  }

  /* Subtle float — bob on wrap + rock on sticker (mobile + desktop) */
  .hero-sticker-wrap {
    cursor: grab;
    animation: hero-sticker-bob 6s ease-in-out infinite;
    will-change: transform;
  }

  .hero-sticker-pos--work {
    animation-delay: 0s;
  }

  .hero-sticker-pos--cloud {
    animation-delay: -2s;
  }

  .hero-sticker-pos--one {
    animation-delay: -3.6s;
  }

  .hero-sticker-pos--work .hero-sticker {
    animation-delay: -0.4s;
  }

  .hero-sticker-pos--cloud .hero-sticker {
    animation-delay: -2.3s;
  }

  .hero-sticker-pos--one .hero-sticker {
    animation-delay: -4.1s;
  }

  @keyframes hero-sticker-bob {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }

    50% {
      transform: translate3d(0, -0.55rem, 0);
    }
  }

  @keyframes hero-sticker-rock {
    0%,
    100% {
      transform: rotate(var(--hero-peel-tilt, 0deg));
    }

    50% {
      transform: rotate(calc(var(--hero-peel-tilt, 0deg) + 2deg));
    }
  }

  @media (min-width: 768px) {
    @keyframes hero-sticker-bob {
      0%,
      100% {
        transform: translate3d(0, 0, 0);
      }

      50% {
        transform: translate3d(0, -0.9rem, 0);
      }
    }

    @keyframes hero-sticker-rock {
      0%,
      100% {
        transform: rotate(var(--hero-peel-tilt, 0deg));
      }

      50% {
        transform: rotate(calc(var(--hero-peel-tilt, 0deg) + 2.5deg));
      }
    }
  }

  /* Closer to center than hard edges */
  .hero-sticker-pos--work {
    left: 0.15rem;
    top: 14%;
  }

  .hero-sticker-pos--cloud {
    right: 0;
    top: 10%;
  }

  .hero-sticker-pos--one {
    left: 0.25rem;
    top: auto;
    bottom: 9%;
  }

  @media (min-width: 768px) {
    .hero-sticker {
      width: min(24vw, 320px);
    }

    .hero-sticker-pos--work {
      left: 1.5%;
      top: 8%;
    }

    .hero-sticker-pos--cloud {
      right: -0.25rem;
      top: 6%;
    }

    .hero-sticker-pos--one {
      left: 3%;
      bottom: 28%;
    }
  }

  @media (min-width: 1024px) {
    .hero-sticker {
      width: min(25vw, 380px);
    }
  }

  @media (min-width: 1280px) {
    .hero-sticker {
      width: 400px;
    }

    .hero-sticker-pos--work {
      left: 2%;
      top: 9%;
    }

    .hero-sticker-pos--cloud {
      right: -0.75rem;
      top: 7%;
    }

    .hero-sticker-pos--one {
      left: 4.5%;
      bottom: 30%;
    }
  }

  .hero-sticker-wrap--size-md .hero-sticker {
    width: min(38vw, 10.25rem);
  }

  @media (min-width: 768px) {
    .hero-sticker-wrap--size-md .hero-sticker {
      width: min(21vw, 280px);
    }
  }

  @media (min-width: 1024px) {
    .hero-sticker-wrap--size-md .hero-sticker {
      width: min(22vw, 320px);
    }
  }

  @media (min-width: 1280px) {
    .hero-sticker-wrap--size-md .hero-sticker {
      width: 340px;
    }
  }

  .hero-sticker-wrap--size-sm .hero-sticker {
    width: min(36vw, 9.5rem);
  }

  @media (min-width: 768px) {
    .hero-sticker-wrap--size-sm .hero-sticker {
      width: min(18vw, 230px);
    }
  }

  @media (min-width: 1024px) {
    .hero-sticker-wrap--size-sm .hero-sticker {
      width: min(19vw, 260px);
    }
  }

  @media (min-width: 1280px) {
    .hero-sticker-wrap--size-sm .hero-sticker {
      width: 280px;
    }
  }

  /* Peel from anchored corner — tilt base + hover lift */
  .hero-sticker-wrap--peel-tl .hero-sticker {
    --hero-peel-tilt: -8deg;
    transform-origin: 18% 88%;
  }

  .hero-sticker-wrap--peel-tr .hero-sticker {
    --hero-peel-tilt: 8deg;
    transform-origin: 82% 88%;
  }

  .hero-sticker-wrap--peel-bl .hero-sticker {
    --hero-peel-tilt: -14deg;
    transform-origin: 22% 92%;
  }

  .hero-sticker-wrap:active {
    cursor: grabbing;
  }

  .hero-sticker-wrap--peel-tl:hover .hero-sticker {
    animation-play-state: paused;
    transform: translate(-6px, -14px) rotate(-13deg) scale(1.02);
    filter: drop-shadow(0 22px 34px rgba(0, 0, 0, 0.22));
  }

  .hero-sticker-wrap--peel-tr:hover .hero-sticker {
    animation-play-state: paused;
    transform: translate(6px, -14px) rotate(13deg) scale(1.02);
    filter: drop-shadow(0 22px 34px rgba(0, 0, 0, 0.22));
  }

  .hero-sticker-wrap--peel-bl:hover .hero-sticker {
    animation-play-state: paused;
    transform: translate(-4px, -16px) rotate(-20deg) scale(1.02);
    filter: drop-shadow(0 22px 34px rgba(0, 0, 0, 0.22));
  }

  .hero-sticker-wrap--peel-tl:active .hero-sticker {
    transform: translate(-3px, -8px) rotate(-10deg) scale(1.01);
  }

  .hero-sticker-wrap--peel-tr:active .hero-sticker {
    transform: translate(3px, -8px) rotate(10deg) scale(1.01);
  }

  .hero-sticker-wrap--peel-bl:active .hero-sticker {
    transform: translate(-2px, -9px) rotate(-16deg) scale(1.01);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-media[data-media-tilted]:not([data-media-flying]) {
      animation: none;
      transform: rotate(-4deg);
    }

    .hero-sticker {
      transition: none;
      animation: none;
    }

    .hero-sticker-wrap {
      animation: none;
    }

    .hero-sticker-wrap--peel-tl .hero-sticker {
      transform: rotate(-8deg);
    }

    .hero-sticker-wrap--peel-tr .hero-sticker {
      transform: rotate(8deg);
    }

    .hero-sticker-wrap--peel-bl .hero-sticker {
      transform: rotate(-14deg);
    }

    .hero-sticker-wrap:hover .hero-sticker,
    .hero-sticker-wrap:active .hero-sticker {
      filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.16));
    }
  }
</style>
