---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { landingContent } from "../../content/landing";
import TrustedByMarquee from "../ui/TrustedByMarquee.astro";
import workSticker from "../../assets/images/stickers/work.webp";
import cloudSticker from "../../assets/images/stickers/cloud.webp";
import numberOneSticker from "../../assets/images/stickers/number-one.webp";
import "../../styles/sections/hero.css";

const { body, primaryCta } = landingContent.hero.value;

type HeroSticker = {
  src: ImageMetadata;
  peel: "tl" | "tr" | "bl";
  size: "sm" | "md" | "lg";
  pos: "work" | "cloud" | "one";
};

/** Sit at the edges, z below the headline so copy stays readable. */
const heroStickers: HeroSticker[] = [
  {
    src: workSticker,
    peel: "tl",
    size: "md",
    pos: "work",
  },
  {
    src: cloudSticker,
    peel: "tr",
    size: "lg",
    pos: "cloud",
  },
  {
    src: numberOneSticker,
    peel: "bl",
    size: "sm",
    pos: "one",
  },
];
---

<section
  data-nav-tone="yellow"
  class="pointer-events-none relative z-20 min-h-dvh overflow-hidden bg-transparent text-charcoal"
>

  <div
    class="hero-shell pointer-events-none relative z-10 mx-auto flex min-h-dvh max-w-content flex-col items-center justify-between px-gutter text-center pt-[calc(var(--site-header-h,5.5rem)+1rem)] pb-2 md:pb-4"
  >
    <!-- Center Cluster: Headline + Peek Media + Body + CTA -->
    <div class="pointer-events-none my-auto flex flex-col items-center w-full pt-2 md:pt-4">
      <div class="hero-title-wrap relative z-20 mx-auto w-full">
        <!-- Hero peek: compact landscape tucked in the center between line 1 and 2 -->
        <span
          data-media-origin
          class="pointer-events-none absolute left-1/2 top-[48%] z-20 aspect-video w-[min(20vw,10rem)] md:w-[min(16vw,9.5rem)] -translate-x-1/2 -translate-y-1/2"
          aria-hidden="true"
        >
          <div
            data-hero-media
            data-media-tilted
            class="hero-media h-full w-full overflow-hidden bg-charcoal shadow-ambient"
          >
            <div class="relative h-full w-full">
              <video
                autoplay
                muted
                loop
                playsinline
                preload="auto"
                class="h-full w-full object-cover"
              >
                <source src="/hero-loop.mp4" type="video/mp4" />
              </video>
            </div>
          </div>
        </span>

        <h1
          class="hero-title relative w-full font-display font-black uppercase tracking-tight text-charcoal"
        >
          <span class="relative z-10 block whitespace-nowrap">YOUR ENTIRE CREATIVE</span>
          <span class="relative z-30 mt-1 block whitespace-nowrap md:mt-2.5">TEAM IN A BOX</span>
        </h1>
      </div>

      <p class="relative z-[12] mt-6 max-w-[20rem] text-pretty text-[1.05rem] leading-relaxed text-charcoal/85 md:mt-8 md:max-w-2xl md:text-[1.25rem]">
        {body}
      </p>

      <a
        class="group btn-3d-skeuo btn-shine pointer-events-auto relative z-[12] mt-6 inline-flex min-h-14 items-center justify-center gap-4 rounded-full px-8 py-3.5 text-paper md:mt-7"
        href={primaryCta.href}
      >
        <span class="font-label text-sm md:text-base font-bold tracking-wide">
          {primaryCta.label}
        </span>
        <div class="flex size-8 items-center justify-center rounded-full bg-paper/15 text-paper transition-all duration-300 group-hover:translate-x-1 group-hover:bg-brand-yellow group-hover:text-charcoal shadow-sm">
          <svg class="size-4 stroke-[2.5]" fill="none" viewBox="0 0 16 16">
            <path d="M3 8h9M8 3.5 12.5 8 8 12.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
      </a>

      <!-- TrustedByMarquee tightly coupled below CTA -->
      <div class="w-full mt-5 md:mt-7">
        <TrustedByMarquee class="pointer-events-none relative z-[12] w-full" />
      </div>
    </div>

    <!-- Floating Stickers dispersed across the hero canvas -->
    {
      heroStickers.map((sticker) => (
        <div
          class:list={[
            "hero-sticker-wrap pointer-events-auto absolute z-[8]",
            `hero-sticker-wrap--peel-${sticker.peel}`,
            `hero-sticker-pos--${sticker.pos}`,
            sticker.size === "sm" && "hero-sticker-wrap--size-sm",
            sticker.size === "md" && "hero-sticker-wrap--size-md",
          ]}
          aria-hidden="true"
        >
          <Image
            src={sticker.src}
            alt=""
            class="hero-sticker"
            widths={[120, 180, 240, 320, 480]}
            sizes="(max-width: 767px) 42vw, (max-width: 1023px) 18vw, 300px"
            loading="eager"
            decoding="async"
            fetchpriority={sticker.pos === "cloud" ? "high" : "auto"}
          />
        </div>
      ))
    }
  </div>
</section>

