---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getTranslations, type SupportedLocale } from "../../i18n";
import TrustedByMorph from "../ui/TrustedByMorph.astro";
import TrustedByMarquee from "../ui/TrustedByMarquee.astro";
import cloudSticker from "../../assets/images/stickers/cloud.webp";
import workSticker from "../../assets/images/stickers/work.webp";
import numberOneSticker from "../../assets/images/stickers/number-one.webp";
import "../../styles/sections/hero.css";

const currentLocale = (Astro.currentLocale as SupportedLocale) || "en";
const t = getTranslations(currentLocale);

type HeroSticker = {
  src: ImageMetadata;
  peel: "tl" | "tr" | "bl";
  size: "sm" | "md" | "lg";
  pos: "work" | "cloud" | "one";
};

const heroStickers: HeroSticker[] = [
  {
    src: workSticker,
    peel: "tl",
    size: "lg",
    pos: "work",
  },
  {
    src: cloudSticker,
    peel: "tr",
    size: "md",
    pos: "cloud",
  },
  {
    src: numberOneSticker,
    peel: "tr",
    size: "sm",
    pos: "one",
  },
];
---

<section
  id="hero"
  data-hero-section
  data-nav-tone="yellow"
  class="pointer-events-none relative z-20 min-h-dvh overflow-hidden bg-transparent text-charcoal flex flex-col justify-between"
>
  <div
    class="hero-shell pointer-events-none relative z-20 mx-auto flex w-full max-w-content flex-1 flex-col justify-between px-gutter pt-[calc(var(--site-header-h,5.5rem)+clamp(1.25rem,3.2vh,2.5rem))] pb-3 md:pb-5"
  >
    <!-- Stepped Editorial Typography (ONLY the title container, matched with navbar) -->
    <div class="pointer-events-none relative my-auto w-full max-w-[61rem] mx-auto py-2 md:py-4">
      <div class="hero-stepped-wrap relative w-full">
        <!-- Top Step: your entire (Offset to the left of center, handwritten font, uncropped) -->
        <div class="hero-step-line hero-step-line--top relative z-20">
          <h1 class="font-accent font-bold text-charcoal leading-[0.7] tracking-normal">
            <span class="block overflow-hidden pt-1 pb-10 pl-0 pr-4 text-[clamp(3rem,7vw,5.75rem)]">
              <span data-hero-title-line class="block whitespace-nowrap will-change-transform -rotate-1">{t.hero.steppedLineTop}</span>
            </span>
          </h1>
        </div>

        <!-- Middle Step: CREATIVE / CREATIVO (Dead center anchor in the hero, balanced monumental scale) -->
        <div class="hero-step-line hero-step-line--center relative z-10">
          <div class="font-display font-black uppercase text-charcoal leading-[0.78] tracking-tight">
            <span class="block overflow-hidden pt-1 pb-2 text-[clamp(8.5rem,21.5vw,21rem)]" aria-label={t.hero.steppedLineCenter}>
              <span class="inline-flex whitespace-nowrap will-change-transform" data-hero-creative-wrap aria-hidden="true">
                {
                  t.hero.steppedLineCenter.split("").map((letter) => (
                    <span
                      data-hero-creative-letter
                      class="inline-block will-change-transform"
                    >
                      {letter}
                    </span>
                  ))
                }
              </span>
            </span>
          </div>
        </div>

        <!-- Lower Step: TEAM in a BOX / EN una CAJA (Offset to the right, handwritten accent middle) -->
        <div class="hero-step-line hero-step-line--bottom">
          <div class="font-display font-black uppercase text-charcoal leading-[0.85] tracking-tight">
            <span class="block overflow-hidden pb-1 text-[clamp(4.25rem,10vw,8.5rem)]">
              <span data-hero-title-line class="inline-flex items-baseline gap-2.5 sm:gap-4 whitespace-nowrap will-change-transform">
                <span>{t.hero.steppedLineBottomStart}</span>
                <span class="font-accent font-bold normal-case text-[0.9em] -rotate-2 inline-block px-1 text-charcoal">{t.hero.steppedLineBottomMiddle}</span>
                <span>{t.hero.steppedLineBottomEnd}</span>
              </span>
            </span>
          </div>
        </div>

        <!-- Bottom Left: Description + Single Primary CTA (See Plans) - Lower and further to the left -->
        <div class="hero-desc-cta-wrap pointer-events-auto z-20">
          <p
            data-hero-body
            class="max-w-[17.5rem] sm:max-w-[19rem] font-body font-medium text-xs sm:text-sm md:text-[0.925rem] leading-relaxed text-charcoal/85 will-change-transform"
          >
            {t.hero.body}
          </p>

          <div data-hero-cta class="mt-3.5 sm:mt-4 flex items-center will-change-transform">
            <a
              class="group btn-3d-skeuo btn-shine inline-flex min-h-12 items-center justify-center gap-3 rounded-full px-6 py-2.5 text-paper cursor-pointer shadow-md"
              href={t.header.primaryCta.href}
            >
              <span class="font-label text-sm sm:text-base font-bold tracking-wide">
                {t.hero.cta}
              </span>
              <div class="flex size-7 items-center justify-center rounded-full bg-paper/15 text-paper transition-all duration-300 group-hover:translate-x-1 group-hover:bg-brand-yellow group-hover:text-charcoal shadow-sm">
                <svg class="size-3.5 stroke-[2.5]" fill="none" viewBox="0 0 16 16">
                  <path d="M3 8h9M8 3.5 12.5 8 8 12.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Centered Logo Marquee (Always maintained in the center) -->
    <div data-hero-morph-wrap class="pointer-events-auto w-full mt-6 md:mt-8 will-change-transform relative z-20">
      <div class="block md:hidden w-[calc(100%+var(--spacing-gutter)*2)] -mx-[var(--spacing-gutter)]">
        <TrustedByMarquee
          label="Over 40+ fast-growing brands & creative teams use Puff"
        />
      </div>
      <div class="hidden md:block">
        <TrustedByMorph />
      </div>
    </div>
  </div>

  <!-- Floating Stickers dispersed across the hero canvas -->
  {
    heroStickers.map((sticker) => (
      <div
        data-hero-sticker
        data-sticker-pos={sticker.pos}
        class:list={[
          "hero-sticker-wrap pointer-events-auto absolute z-30",
          `hero-sticker-wrap--peel-${sticker.peel}`,
          `hero-sticker-pos--${sticker.pos}`,
          sticker.size === "sm" && "hero-sticker-wrap--size-sm",
          sticker.size === "md" && "hero-sticker-wrap--size-md",
          sticker.size === "lg" && "hero-sticker-wrap--size-lg",
        ]}
        aria-hidden="true"
      >
        <div data-hero-sticker-inner class="hero-sticker-inner will-change-transform">
          <Image
            src={sticker.src}
            alt=""
            class="hero-sticker"
            widths={[120, 180, 240, 320, 480]}
            sizes="(max-width: 767px) 42vw, (max-width: 1023px) 18vw, 300px"
            loading="eager"
            decoding="async"
            fetchpriority={sticker.pos === "cloud" ? "high" : "auto"}
          />
        </div>
      </div>
    ))
  }
</section>

<script>
  import { initHeroMotion } from "../../scripts/motion/hero-motion";

  let motionInstance: ReturnType<typeof initHeroMotion> = null;

  function setup() {
    motionInstance = initHeroMotion();
  }

  function teardown() {
    motionInstance?.kill();
    motionInstance = null;
  }

  document.addEventListener("astro:page-load", setup);
  document.addEventListener("astro:before-swap", teardown);
</script>
