---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { landingContent } from "../../content/landing";
import TrustedByMorph from "../ui/TrustedByMorph.astro";
import TrustedByMarquee from "../ui/TrustedByMarquee.astro";
import workSticker from "../../assets/images/stickers/work.webp";
import cloudSticker from "../../assets/images/stickers/cloud.webp";
import numberOneSticker from "../../assets/images/stickers/number-one.webp";
import "../../styles/sections/hero.css";

const { body, primaryCta } = landingContent.hero.value;

type HeroSticker = {
  src: ImageMetadata;
  peel: "tl" | "tr" | "bl";
  size: "sm" | "md" | "lg";
  pos: "work" | "cloud" | "one";
};

/** Sit at the edges, z below the headline so copy stays readable. */
const heroStickers: HeroSticker[] = [
  {
    src: workSticker,
    peel: "tl",
    size: "md",
    pos: "work",
  },
  {
    src: cloudSticker,
    peel: "tr",
    size: "lg",
    pos: "cloud",
  },
  {
    src: numberOneSticker,
    peel: "bl",
    size: "sm",
    pos: "one",
  },
];
---

<section
  id="hero"
  data-hero-section
  data-nav-tone="yellow"
  class="pointer-events-none relative z-20 min-h-dvh overflow-hidden bg-transparent text-charcoal"
>

  <div
    class="hero-shell pointer-events-none relative z-10 mx-auto flex min-h-dvh max-w-content flex-col items-center justify-between px-gutter text-center pt-[calc(var(--site-header-h,5.5rem)+clamp(1.75rem,4.5vh,3.5rem))] pb-4 md:pb-6"
  >
    <!-- Center Cluster: Headline + Body + CTA + Logos (Jitter hierarchy) -->
    <div class="pointer-events-none my-auto flex flex-col items-center w-full pt-4 md:pt-6">
      <div class="hero-title-wrap relative z-20 mx-auto w-full">
        <h1
          class="hero-title relative w-full font-display font-black uppercase tracking-tight text-charcoal"
        >
          <!-- Mobile (3 punchy lines for gigantic Jitter-scale typography) -->
          <div class="block md:hidden">
            <span class="block overflow-hidden pb-1">
              <span data-hero-title-line class="relative z-10 block whitespace-nowrap will-change-transform">YOUR ENTIRE</span>
            </span>
            <span class="block overflow-hidden mt-1 pb-1">
              <span data-hero-title-line class="relative z-20 block whitespace-nowrap will-change-transform">CREATIVE TEAM</span>
            </span>
            <span class="block overflow-hidden mt-1 pb-1">
              <span data-hero-title-line class="relative z-30 block whitespace-nowrap will-change-transform">IN A BOX</span>
            </span>
          </div>

          <!-- Desktop (2 wide lines) -->
          <div class="hidden md:block">
            <span class="block overflow-hidden pb-1">
              <span data-hero-title-line class="relative z-10 block whitespace-nowrap will-change-transform">YOUR ENTIRE CREATIVE</span>
            </span>
            <span class="block overflow-hidden mt-2.5 pb-1">
              <span data-hero-title-line class="relative z-20 block whitespace-nowrap will-change-transform">TEAM IN A BOX</span>
            </span>
          </div>
        </h1>
      </div>

      <p data-hero-body class="relative z-[12] mt-4 max-w-[19rem] text-pretty text-sm leading-relaxed text-charcoal/75 sm:mt-6 sm:max-w-xl sm:text-base md:mt-8 md:max-w-2xl md:text-xl lg:text-[1.35rem] will-change-transform">
        {body}
      </p>

      <a
        data-hero-cta
        class="group btn-3d-skeuo btn-shine pointer-events-auto relative z-[12] mt-7 inline-flex min-h-14 items-center justify-center gap-4 rounded-full px-9 py-4 text-paper md:mt-8 will-change-transform"
        href={primaryCta.href}
      >
        <span class="font-label text-base font-bold tracking-wide md:text-lg">
          {primaryCta.label}
        </span>
        <div class="flex size-9 items-center justify-center rounded-full bg-paper/15 text-paper transition-all duration-300 group-hover:translate-x-1 group-hover:bg-brand-yellow group-hover:text-charcoal shadow-sm">
          <svg class="size-4.5 stroke-[2.5]" fill="none" viewBox="0 0 16 16">
            <path d="M3 8h9M8 3.5 12.5 8 8 12.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
      </a>

      <!-- Jitter-style Client Proof Bar: Marquee on mobile, Morph Grid on desktop -->
      <div data-hero-morph-wrap class="pointer-events-auto w-full mt-8 md:mt-14 will-change-transform">
        <div class="block md:hidden w-[calc(100%+var(--spacing-gutter)*2)] -mx-[var(--spacing-gutter)]">
          <TrustedByMarquee
            label="Over 40+ fast-growing brands & creative teams use Puff"
          />
        </div>
        <div class="hidden md:block">
          <TrustedByMorph />
        </div>
      </div>
    </div>
  </div>

  <!-- Floating Stickers placed on full canvas edges outside max-w-content -->
  {
    heroStickers.map((sticker) => (
      <div
        data-hero-sticker
        data-sticker-pos={sticker.pos}
        class:list={[
          "hero-sticker-wrap pointer-events-auto absolute z-30",
          `hero-sticker-wrap--peel-${sticker.peel}`,
          `hero-sticker-pos--${sticker.pos}`,
          sticker.size === "sm" && "hero-sticker-wrap--size-sm",
          sticker.size === "md" && "hero-sticker-wrap--size-md",
          sticker.size === "lg" && "hero-sticker-wrap--size-lg",
        ]}
        aria-hidden="true"
      >
        <div data-hero-sticker-inner class="hero-sticker-inner will-change-transform">
          <Image
            src={sticker.src}
            alt=""
            class="hero-sticker"
            widths={[120, 180, 240, 320, 480]}
            sizes="(max-width: 767px) 42vw, (max-width: 1023px) 18vw, 300px"
            loading="eager"
            decoding="async"
            fetchpriority={sticker.pos === "cloud" ? "high" : "auto"}
          />
        </div>
      </div>
    ))
  }
</section>

<script>
  import { initHeroMotion } from "../../scripts/motion/hero-motion";

  let motionInstance: ReturnType<typeof initHeroMotion> = null;

  function setup() {
    motionInstance = initHeroMotion();
  }

  function teardown() {
    motionInstance?.kill();
    motionInstance = null;
  }

  document.addEventListener("astro:page-load", setup);
  document.addEventListener("astro:before-swap", teardown);
</script>

