---
/**
 * Second section slot — the hero media card lands here on scroll.
 * Tall section + sticky stage so the settle/pixel reveal can be seen.
 */
---

<section
  id="feature-media"
  class="pointer-events-none relative z-10 h-[210vh] bg-transparent md:h-[220vh]"
  data-media-expand
  data-nav-tone="yellow"
  aria-label="Featured work"
>
  <div
    class="media-expand-stage sticky top-0 flex min-h-dvh items-center px-4 py-10 md:px-gutter md:py-8"
    data-media-expand-stage
  >
    <div class="mx-auto w-full max-w-content">
      <div class="media-target relative mx-auto" data-media-target></div>
    </div>
  </div>
</section>

<style>
  /* Mobile only — portrait 9:16 */
  @media (max-width: 767px) {
    .media-target {
      aspect-ratio: 9 / 16;
      width: min(74vw, 18.5rem);
    }
  }

  /* Desktop — near full content width + tall frame */
  @media (min-width: 768px) {
    .media-target {
      aspect-ratio: 16 / 10;
      width: min(100%, calc(min(76vh, 52rem) * 16 / 10));
      max-width: 100%;
    }
  }
</style>

<script>
  import { whenIdle } from "../../scripts/defer-idle";

  let cleanup: (() => void) | undefined;

  const boot = () => {
    cleanup?.();
    whenIdle(async () => {
      const { initMediaHandoff } = await import("../../scripts/motion/media-handoff");
      cleanup = await initMediaHandoff();
    });
  };

  document.addEventListener("astro:page-load", boot);

  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>
