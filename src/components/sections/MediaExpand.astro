---
/**
 * Second section slot — the hero media card lands here on scroll.
 * Tall section + sticky stage so the settle/pixel reveal can be seen.
 */
---

<section
  id="feature-media"
  class="pointer-events-none relative z-10 h-[210vh] bg-transparent md:h-[220vh]"
  data-media-expand
  data-nav-tone="yellow"
  aria-label="Featured work"
>
  <div
    class="media-expand-stage sticky top-0 flex min-h-dvh w-full items-center justify-center p-3 md:p-6"
    data-media-expand-stage
  >
    <div
      class="media-target relative w-[calc(100vw-1.5rem)] md:w-[calc(100vw-3rem)] h-[calc(100dvh-2.5rem)] md:h-[calc(100dvh-4rem)] max-w-[1780px] max-h-[92dvh] overflow-hidden"
      data-media-target
    ></div>
  </div>
</section>

<style>
  /* Mobile — 16/9 video with safe perimeter paddings */
  @media (max-width: 767px) {
    .media-target {
      aspect-ratio: 16 / 9;
      width: min(94vw, 32rem);
      max-height: calc(100dvh - 3.5rem);
    }
  }

  /* Desktop — 16/9 with clean perimetral paddings */
  @media (min-width: 768px) {
    .media-target {
      aspect-ratio: 16 / 9;
      width: min(calc(100vw - clamp(2rem, 4vw, 3.5rem)), calc((100vh - clamp(2.5rem, 5.5vh, 4.5rem)) * (16 / 9)));
      height: min(calc(100vh - clamp(2.5rem, 5.5vh, 4.5rem)), calc((100vw - clamp(2rem, 4vw, 3.5rem)) * (9 / 16)));
      max-width: 1780px;
    }
  }
</style>

<script>
  import { initMediaHandoff } from "../../scripts/motion/media-handoff";

  let cleanup: (() => void) | undefined;

  const boot = () => {
    cleanup?.();
    cleanup = initMediaHandoff();
  };

  // Run on initial page load and every View Transitions navigation (including back/forward)
  document.addEventListener("astro:page-load", boot);

  // Clean up GSAP timelines/triggers before Astro swaps the DOM
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>
