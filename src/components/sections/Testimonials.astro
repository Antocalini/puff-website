---
import { Image } from "astro:assets";
import bulbSticker from "../../assets/images/stickers/bulb.webp";
import FloatingSticker from "../ui/FloatingSticker.astro";
import PuffSticker from "../ui/PuffSticker.astro";
import { testimonials } from "../../content/testimonials";
import { clientLogosRow1 } from "../../content/clientLogos";
import "../../styles/sections/testimonials.css";

const logosRow1 = [...clientLogosRow1, ...clientLogosRow1];
---

<section
  id="testimonials"
  data-nav-tone="yellow"
  class="relative z-10 w-full flex flex-col justify-center scroll-mt-6 bg-brand-yellow pt-16 pb-0 md:pt-20 md:pb-0 text-charcoal overflow-x-clip"
>
  
  <div class="mx-auto max-w-content px-gutter w-full relative z-20">
    
    <!-- Section Header (Tighter top spacing) -->
    <div class="mx-auto flex max-w-3xl flex-col items-center text-center pb-4 md:pb-8">
      <PuffSticker tone="lavender" rotate="rotate-[5deg]">
        Client Proof & Reviews
      </PuffSticker>
      <h2 class="mt-3 font-display text-[clamp(3.25rem,8vw,6.75rem)] font-black uppercase leading-[0.86] tracking-tight text-charcoal md:mt-4">
        Stand With Clients
      </h2>
      <p class="mt-3 max-w-2xl font-body text-base leading-relaxed text-charcoal/80 md:mt-4 md:text-lg">
        From product teams to marketing leaders, brands trust Puff to move fast without sacrificing craft. Hear how they ship design, motion, and campaigns on a subscription that scales with them — no retainers, no scope creep, no agency runaround.
      </p>
    </div>

    <!-- Central Floating Testimonial Card Stack -->
    <div class="relative z-10 mx-auto max-w-content w-full py-4 md:py-6">
      <div class="relative mx-auto max-w-md md:max-w-2xl" data-testimonial-container>
        
        <!-- Solid black back card — scroll-tilted via GSAP -->
        <div
          data-testimonial-accent
          class="absolute inset-0 rounded-[1.5rem] bg-charcoal shadow-lg md:rounded-[2rem]"
        ></div>

        <!-- Front White Main Card -->
        <div class="relative z-10 rounded-[1.5rem] border border-charcoal/10 bg-paper p-5 shadow-md md:rounded-[2rem] md:p-12">
          
          <!-- Yellow Quote Icon -->
          <div class="text-brand-yellow">
            <svg class="size-6 md:size-8" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"></path>
            </svg>
          </div>

          <!-- Quote Body inside Vertical Mask Container -->
          <div class="mt-3 flex min-h-[4.5rem] items-center overflow-hidden md:mt-4 md:min-h-[90px]">
            <p data-testimonial-quote class="font-body text-sm font-bold leading-relaxed text-charcoal md:text-xl">
              "{testimonials[0].quote}"
            </p>
          </div>

          <!-- Author & Pagination Row inside Vertical Mask Container -->
          <div class="mt-5 flex flex-col gap-3 border-t border-charcoal/10 pt-3 sm:flex-row sm:items-center sm:justify-between md:mt-8 md:gap-4 md:pt-4">
            <div class="overflow-hidden">
              <div data-testimonial-meta>
                <p
                  data-testimonial-author
                  class="font-display text-lg font-black uppercase text-charcoal md:text-xl"
                >
                  {testimonials[0].author}
                </p>
                <p data-testimonial-company class="font-body text-xs font-medium text-charcoal/70">
                  {testimonials[0].company}
                </p>
              </div>
            </div>

            <!-- Pagination Bar Indicators with Yellow Active Bar -->
            <div class="flex items-center gap-2">
              {testimonials.map((_, idx) => (
                <button
                  type="button"
                  data-testimonial-dot={idx}
                  class:list={["testimonial-dot", idx === 0 && "is-active"]}
                  aria-label={`Go to slide ${idx + 1}`}
                >
                  <span class="testimonial-dot__bar" aria-hidden="true"></span>
                </button>
              ))}
            </div>
          </div>

        </div>

        <!-- Bulb Sticker moved higher up on the side -->
        <FloatingSticker
          src={bulbSticker}
          peel="bl"
          size="moment"
          rotate={-24}
          class="top-1/4 -left-6 z-20 -translate-x-[40%] -translate-y-1/2 md:-left-12 md:-translate-x-[55%]"
        />

      </div>
    </div>

  </div>

  <!-- Intersecting Logo Marquee between Testimonials and Pricing -->
  <div class="relative w-full mt-16 md:mt-24 py-8 md:py-10 overflow-hidden bg-brand-yellow">
    <div class="flex overflow-hidden whitespace-nowrap select-none">
      <div class="marquee-content flex shrink-0 items-center gap-8 pr-8 md:gap-12 md:pr-12 animate-marquee-slow">
        {logosRow1.map((item) => (
          <Image
            src={item.image}
            alt=""
            class="h-16 w-auto max-w-[15rem] object-contain md:h-20 md:max-w-[20rem] opacity-90 mix-blend-multiply grayscale brightness-[0.8] contrast-[200%] transition-all duration-300 hover:opacity-100 hover:filter-none hover:mix-blend-normal"
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
      <div class="marquee-content flex shrink-0 items-center gap-8 pr-8 md:gap-12 md:pr-12 animate-marquee-slow" aria-hidden="true">
        {logosRow1.map((item) => (
          <Image
            src={item.image}
            alt=""
            class="h-16 w-auto max-w-[15rem] object-contain md:h-20 md:max-w-[20rem] opacity-90 mix-blend-multiply grayscale brightness-[0.8] contrast-[200%] transition-all duration-300 hover:opacity-100 hover:filter-none hover:mix-blend-normal"
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
    </div>
  </div>

</section>

<script>
  import {
    setupTestimonials,
    teardownTestimonials,
  } from "../../scripts/testimonials-carousel";

  document.addEventListener("astro:page-load", setupTestimonials);
  document.addEventListener("astro:before-swap", teardownTestimonials);
</script>
