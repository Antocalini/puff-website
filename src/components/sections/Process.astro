---
import BenefitsDeck from "../ui/BenefitsDeck.astro";
import PuffSticker from "../ui/PuffSticker.astro";
import { getTranslations, type SupportedLocale } from "../../i18n";

const currentLocale = (Astro.currentLocale as SupportedLocale) || "en";
const t = getTranslations(currentLocale);

const steps = [
  {
    number: "1",
    title: t.process.steps[0].title,
    description: t.process.steps[0].description,
    cardClass: "border-charcoal/10 bg-accent-lime text-charcoal",
    bodyClass: "text-charcoal",
    badgeClass: "border-charcoal/20 bg-paper text-charcoal",
    rotation: "-rotate-6",
    desktopClass: "top-[25%] left-[0%] lg:left-[2%]",
    mobileClass: "bottom-[5%] left-[-2%] w-[11.25rem]",
    zClass: "z-30",
  },
  {
    number: "2",
    title: t.process.steps[1].title,
    description: t.process.steps[1].description,
    cardClass: "border-paper/10 bg-accent-cobalt text-paper",
    bodyClass: "text-paper",
    badgeClass: "border-charcoal/20 bg-paper text-charcoal",
    rotation: "rotate-2",
    desktopClass: "-top-2 lg:top-0 left-1/2 -translate-x-1/2",
    mobileClass: "top-1 left-1/2 w-[12rem] -translate-x-1/2",
    zClass: "z-30",
  },
  {
    number: "3",
    title: t.process.steps[2].title,
    description: t.process.steps[2].description,
    cardClass: "border-charcoal/10 bg-accent-pink text-charcoal",
    bodyClass: "text-charcoal",
    badgeClass: "border-charcoal/20 bg-paper text-charcoal",
    rotation: "-rotate-3",
    desktopClass: "bottom-[10%] right-[0%] lg:right-[2%]",
    mobileClass: "bottom-[3%] right-[-2%] w-[11.25rem]",
    zClass: "z-30",
  },
];
---

<section
  id="how-it-works"
  data-process-section
  data-nav-tone="yellow"
  class="relative z-10 flex min-h-dvh flex-col justify-center scroll-mt-6 overflow-hidden bg-brand-yellow pt-[calc(var(--site-header-h,5.5rem)+1.5rem)] pb-6 md:pt-[calc(var(--site-header-h,5.5rem)+2rem)] md:pb-10"
>

  <div
    data-process-circle
    class="absolute left-1/2 top-1/2 z-0 size-[5vw] -translate-x-1/2 -translate-y-1/2 scale-0 rounded-full bg-ink"
  >
  </div>

  <div class="relative z-10 mx-auto w-full max-w-content px-gutter text-center my-auto">
    <div class="relative grid min-h-[min(68vh,38rem)] place-items-center md:min-h-[min(70vh,42rem)]">
      <!-- Text Block 1 — yellow stage: Why everyone's switching to Puff + Stacked Deck -->
      <div data-process-stage-1 class="col-start-1 row-start-1 flex flex-col items-center justify-center w-full">
        <div class="relative flex flex-col items-center justify-center">
          <!-- Top-left corner sticker -->
          <div class="pointer-events-none absolute -top-10 sm:-top-11 md:-top-9 -left-1 sm:-left-3 md:-left-6 z-20 overflow-visible">
            <div data-process-sticker-1 class="will-change-transform">
              <PuffSticker tone="lime" rotate="-rotate-6" class="px-4 py-1.5 md:px-5 md:py-2 text-xs md:text-sm lg:text-base font-black tracking-wider uppercase font-display border-2 border-ink shadow-[4px_4px_0_#111111]">
                {t.process.sticker}
              </PuffSticker>
            </div>
          </div>

          <h2
            class="font-display text-[clamp(3.35rem,11.5vw,6.75rem)] font-black uppercase leading-[0.86] tracking-tight text-charcoal"
          >
          <span class="block overflow-hidden pb-1"
            ><span class="block will-change-transform" data-process-line-1
              >{t.process.titleLine1}</span
            ></span
          >
          <span class="block overflow-hidden pb-1"
            ><span class="block will-change-transform" data-process-line-1
              ><span class="font-accent font-normal italic lowercase tracking-[-0.07em] text-charcoal inline-block -rotate-6 mr-3 sm:mr-4 md:mr-6">{t.process.titleLine2Accent}</span>{t.process.titleLine2End}</span
            ></span
          >
        </h2>
        </div>

        <div class="w-[calc(100%+var(--spacing-gutter)*2)] -mx-[var(--spacing-gutter)] md:w-full md:mx-0 flex justify-center mt-2 overflow-hidden py-2">
          <div data-deck-mask-inner class="w-full flex justify-center will-change-transform">
            <BenefitsDeck />
          </div>
        </div>
      </div>

      <!-- Text Block 2 — dark stage after circle expand -->
      <div class="pointer-events-none relative z-20 col-start-1 row-start-1 flex flex-col items-center justify-center">
        <h2
          class="relative font-display text-[clamp(2.75rem,10.5vw,8.5rem)] font-black uppercase leading-[0.84] tracking-tight text-brand-yellow"
        >
          <span class="block overflow-hidden pb-1"
            ><span class="block will-change-transform" data-process-line-2
              >{t.process.titleDark1}</span
            ></span
          >
          <span class="block overflow-hidden pb-1"
            ><span class="block will-change-transform" data-process-line-2>{t.process.titleDark2}</span
            ></span
          >
          <span class="block overflow-hidden pb-1"
            ><span class="block will-change-transform" data-process-line-2
              >{t.process.titleDark3}</span
            ></span
          >
        </h2>

        <div class="relative mt-8 overflow-hidden md:mt-16">
          <p
            data-process-line-2
            class="max-w-3xl will-change-transform text-pretty font-body font-medium text-base leading-relaxed text-paper md:text-xl"
          >
            {currentLocale === "es" ? (
              <>Con Puff, tener un <strong>equipo de diseño</strong> es <span class="text-highlight mt-1 block text-[clamp(1.75rem,4.5vw,2.5rem)] font-bold leading-[0.95] text-brand-yellow">tan fácil como pedirlo</span></>
            ) : (
              <>With Puff, having a <strong>design team</strong> is <span class="text-highlight mt-1 block text-[clamp(1.75rem,4.5vw,2.5rem)] font-bold leading-[0.95] text-brand-yellow">as easy as requesting it</span></>
            )}
          </p>
        </div>
      </div>

      <!-- Mobile: floating stickers (same clip reveal as desktop) -->
      <div class="pointer-events-none absolute inset-0 z-30 md:hidden">
        {
          steps.map((step) => (
            <div
              class={`absolute pointer-events-auto ${step.zClass} ${step.mobileClass} ${step.rotation}`}
            >
              <div
                data-process-sticker-wrapper
                data-process-sticker-mobile
                class="relative w-full will-change-transform"
              >
                <div
                  data-sticker-face
                  class={`relative h-full w-full overflow-hidden rounded-2xl border p-4 shadow-float ${step.cardClass}`}
                >
                  <div
                    data-sticker-overlay
                    class="absolute inset-0 z-40 bg-[#c8c8c8]"
                    style="box-shadow: inset 0 -8px 16px rgba(0,0,0,0.12);"
                  />
                  <h3 class="relative z-10 text-center font-display text-xl uppercase leading-none tracking-tight">
                    {step.title}
                  </h3>
                  <p
                    class={`relative z-10 mt-1.5 text-center text-xs font-medium leading-snug ${step.bodyClass}`}
                  >
                    {step.description}
                  </p>
                </div>
                <div
                  data-sticker-badge
                  class={`absolute -top-3.5 left-1/2 z-50 flex size-8 -translate-x-1/2 items-center justify-center rounded-full border font-display text-base font-bold ${step.badgeClass}`}
                >
                  {step.number}
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Desktop: floating stickers (cards sit above the title) -->
      <div class="pointer-events-none absolute inset-0 z-30 hidden md:block">
        {
          steps.map((step) => (
            <div
              class={`absolute w-72 lg:w-80 pointer-events-auto ${step.zClass} ${step.desktopClass} ${step.rotation}`}
            >
              <div
                data-process-sticker-wrapper
                data-process-sticker-desktop
                class="relative w-full will-change-transform"
              >
                <div
                  data-sticker-face
                  class={`relative h-full w-full overflow-hidden rounded-2xl border p-6 lg:p-7 shadow-float ${step.cardClass}`}
                >
                  <!-- Backing paper that peels top → bottom as the sticker sticks -->
                  <div
                    data-sticker-overlay
                    class="absolute inset-0 z-40 bg-[#c8c8c8]"
                    style="box-shadow: inset 0 -8px 16px rgba(0,0,0,0.12);"
                  />
                  <h3 class="relative z-10 text-center font-display text-3xl lg:text-[2.25rem] uppercase leading-none tracking-tight">
                    {step.title}
                  </h3>
                  <p
                    class={`relative z-10 mt-2.5 text-center text-sm lg:text-[0.9375rem] font-medium leading-snug ${step.bodyClass}`}
                  >
                    {step.description}
                  </p>
                </div>
                <div
                  data-sticker-badge
                  class={`absolute -top-4.5 lg:-top-5 left-1/2 z-50 flex size-9 lg:size-10 -translate-x-1/2 items-center justify-center rounded-full border font-display text-lg lg:text-xl font-bold shadow-sm ${step.badgeClass}`}
                >
                  {step.number}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { initProcessReveal } from "../../scripts/motion/process-reveal";

  let cleanup: (() => void) | undefined;

  const boot = () => {
    cleanup?.();
    cleanup = initProcessReveal();
  };

  document.addEventListener("astro:page-load", boot);

  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>
