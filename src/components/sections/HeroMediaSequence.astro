---
/**
 * Hero + MediaExpand share one prism layer across both sections.
 * Grid lines are pure CSS (always visible). React only paints hover cells.
 */
import Hero from "./Hero.astro";
import MediaExpand from "./MediaExpand.astro";
import PrismGrid from "../ui/PrismGrid";
---

<div class="relative bg-brand-yellow" data-hero-prism-zone>
  <div
    class="pointer-events-none absolute inset-0 z-[1] min-h-full w-full"
    data-prism-grid-layer
    aria-hidden="true"
  >
    <!-- Stable fill target for the React island (astro-island = display:contents) -->
    <div class="prism-grid-host absolute inset-0 h-full w-full">
      <PrismGrid client:load />
    </div>
  </div>

  <div class="hero-prism-fade pointer-events-none absolute inset-x-0 bottom-0 z-[2]" aria-hidden="true"></div>

  <div class="relative z-10 pointer-events-none">
    <Hero />
    <MediaExpand />
  </div>
</div>

<style>
  /*
   * Always-on grid — does not depend on React hydrate / DOM cell count.
   * React PrismGrid sits on top with a transparent fill and only paints hover.
   */
  [data-prism-grid-layer] {
    background-color: var(--color-brand-yellow);
    background-image:
      linear-gradient(to right, rgb(26 26 26 / 0.16) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(26 26 26 / 0.16) 1px, transparent 1px);
    background-size: 40px 40px;
    background-position: 0 0;
  }

  .hero-prism-fade {
    height: clamp(7rem, 24vh, 16rem);
    background: linear-gradient(
      to bottom,
      rgb(255 209 0 / 0) 0%,
      rgb(255 209 0 / 0.35) 28%,
      rgb(255 209 0 / 0.78) 62%,
      var(--color-brand-yellow) 100%
    );
  }
</style>
