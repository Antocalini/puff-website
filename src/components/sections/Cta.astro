---
import logoPuff from "../../assets/images/logo-puff-completo.svg";
import PuffSticker from "../ui/PuffSticker.astro";
---

<section
  id="book-meeting"
  data-nav-tone="yellow"
  class="relative w-full scroll-anchor-offset overflow-x-clip bg-brand-yellow py-16 md:py-20"
>
  <div class="mx-auto max-w-content px-gutter">
    <div class="relative">
      <div class="absolute -top-5 right-0 z-30 transition-transform duration-500 ease-out hover:scale-110 md:-top-7 md:right-4" aria-hidden="true">
        <PuffSticker
          tone="lime"
          rotate="-rotate-[11deg]"
          class="px-8 py-3.5 text-lg md:px-12 md:py-4 md:text-2xl"
        >
          Free intro
        </PuffSticker>
      </div>

    <div class="relative w-full overflow-hidden rounded-panel bg-ink p-8 shadow-ambient md:rounded-[3rem] md:p-12 lg:p-16">

      <div class="pointer-events-none absolute -left-32 -top-32 h-[500px] w-[500px] rounded-full bg-brand-yellow/10 blur-3xl" aria-hidden="true"></div>

      <div class="relative z-10 grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12 xl:gap-16">

        <!-- Left: copy -->
        <div class="flex flex-col justify-center lg:col-span-6">
          <img
            src={logoPuff.src}
            alt="Puff"
            class="cta-brand-logo mb-6 h-auto w-[min(28vw,5.25rem)] md:w-[min(14vw,6rem)]"
            width={73}
            height={35}
            loading="lazy"
            decoding="async"
          />

          <h2 class="font-display text-[clamp(2.25rem,5vw,4.5rem)] font-black uppercase leading-[0.92] tracking-tight text-paper">
            See if Puff is the right fit for you
            <span class="text-highlight mt-1 block text-[0.62em] font-semibold normal-case leading-[0.95] tracking-normal text-brand-yellow">
              (it totally is)
            </span>
          </h2>

          <p class="mt-6 max-w-md font-body text-lg leading-relaxed text-paper/75 md:text-xl">
            Schedule a quick, 15 minute guided tour through Puff.
          </p>
        </div>

        <!-- Right: compact booking panel → opens Cal modal -->
        <div class="lg:col-span-6">
          <div class="relative flex w-full flex-col items-start gap-6 overflow-hidden rounded-media border border-paper/10 bg-charcoal p-8 md:p-10">
            <div class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-brand-yellow/15 blur-3xl" aria-hidden="true"></div>

            <span class="font-label text-[0.7rem] font-bold uppercase tracking-[0.25em] text-paper/50">
              Next step
            </span>

            <h3 class="relative font-display text-[clamp(2rem,4vw,3rem)] font-black uppercase leading-[0.9] tracking-tight text-paper">
              Pick a time that works for you
            </h3>

            <p class="relative max-w-sm font-body text-base leading-relaxed text-paper/70">
              Opens a calendar overlay — pick a day, choose a slot, done.
            </p>

            <ul class="relative flex flex-col gap-3 font-body text-sm text-paper/75">
              <li class="flex items-center gap-2.5">
                <span class="h-1.5 w-1.5 rounded-full bg-brand-yellow"></span>
                15 minutes · Cal Video
              </li>
              <li class="flex items-center gap-2.5">
                <span class="h-1.5 w-1.5 rounded-full bg-brand-yellow"></span>
                Free · no commitment
              </li>
            </ul>

            <button
              type="button"
              data-cal-link="antonio-c-n5qpwr/15min"
              data-cal-config='{"layout":"month_view","theme":"dark"}'
              class="btn-3d-skeuo-yellow btn-shine relative mt-2 inline-flex min-h-14 items-center justify-center rounded-full px-8 py-3.5 font-label text-sm font-bold tracking-wide text-ink"
            >
              Book 15 Min Intro
            </button>
          </div>
        </div>

      </div>
    </div>
    </div>
  </div>
</section>

<style>
  .cta-brand-logo {
    filter: brightness(0) invert(1);
  }
</style>

<script>
  import { setupCalEmbed } from "../../scripts/cal-embed";

  document.addEventListener("astro:page-load", setupCalEmbed);
</script>
