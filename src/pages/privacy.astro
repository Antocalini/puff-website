---
import { landingContent } from "../content/landing";
import BaseLayout from "../layouts/BaseLayout.astro";

const { title, body } = landingContent.legalPlaceholder.value;
---

<BaseLayout title="Privacy policy / Pending review" description={body}>
  <article class="mx-auto max-w-reading px-gutter py-section">
    <p class="font-label text-label font-bold uppercase tracking-widest text-graphite">Privacy policy</p>
    <h1 class="mt-5 font-display text-display-lg font-black tracking-tight text-ink">{title}</h1>
    <p class="mt-8 text-body-lg text-graphite">{body}</p>
    <p class="mt-6 text-body text-graphite">[NEEDS CLIENT INPUT]: approved Privacy Policy text.</p>
    <a class="mt-10 inline-flex font-label text-label font-bold uppercase tracking-widest text-ink underline underline-offset-4" href="/terms">View Terms of Service</a>
  </article>
</BaseLayout>
