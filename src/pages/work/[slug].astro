---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseMediaSlot from "../../components/ui/CaseMediaSlot.astro";
import {
  getNextProject,
  getProjectAccent,
  projects,
  type CaseMedia,
  type Project,
} from "../../content/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project, nextProject: getNextProject(project.slug) },
  }));
}

type Props = {
  project: Project;
  nextProject: Project;
};

const { project, nextProject } = Astro.props;
const accent = getProjectAccent(project);

const navToneFromBg = (bg: string) =>
  bg.includes("charcoal") || bg.includes("cobalt") ? "ink" : "yellow";

const heroNavTone = navToneFromBg(project.bg);
const nextNavTone = navToneFromBg(nextProject.bg);

const galleryA = project.gallery.slice(0, 3);
const challengeMedia = project.gallery[3];
const galleryB = project.gallery.slice(4, 6);
const approachMedia = project.gallery[6];
const outcomeMedia = project.gallery[7];

const eyebrowClass = `text-highlight text-3xl font-bold leading-none md:text-4xl lg:text-[2.75rem] ${accent.text}`;

const spanClass = (item: CaseMedia) => {
  switch (item.span) {
    case "full":
      return "md:col-span-12";
    case "half":
      return "md:col-span-6";
    case "third":
      return "md:col-span-4";
    default:
      return "md:col-span-6";
  }
};
---

<BaseLayout title={`${project.title} — Puff Case Study`} description={project.summary}>
  <!-- Hero -->
  <section
    class={`relative w-full overflow-hidden ${project.bg} ${project.textColor} pt-28 pb-16 md:pt-36 md:pb-24`}
    data-nav-tone={heroNavTone}
  >
    <div class="mx-auto max-w-content px-gutter">
      <div class="flex items-center justify-between border-b border-current/20 pb-10 md:pb-12">
        <a
          href="/#work"
          class="group inline-flex items-center gap-3 font-label text-sm font-bold uppercase tracking-widest transition-transform duration-300 hover:-translate-x-1"
        >
          <svg class="size-4 transition-transform duration-300 group-hover:-translate-x-1" fill="none" viewBox="0 0 16 16">
            <path d="M13 8H3M8 12.5 3.5 8 8 3.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
          </svg>
          Back to portfolio
        </a>

        <span class="inline-flex shrink-0 items-center justify-center rounded-pill border-[3px] border-current/40 px-8 py-3.5 font-display text-2xl font-black uppercase tracking-[0.1em] sm:text-3xl md:px-12 md:py-5 md:text-4xl lg:px-14 lg:py-6 lg:text-5xl xl:text-6xl">
          {project.category}
        </span>
      </div>

      <div class="mt-10 grid gap-10 md:mt-14 lg:grid-cols-12 lg:items-end lg:gap-12">
        <div class="lg:col-span-8">
          <span class="font-display text-3xl font-black opacity-55 md:text-5xl">{project.number}</span>
          <h1
            class="mt-3 font-display text-[clamp(3.5rem,9.5vw,8.5rem)] font-black uppercase leading-[0.86] tracking-tight"
            transition:name={`project-title-${project.slug}`}
          >
            {project.title}
          </h1>
        </div>
        <p class="max-w-md font-body text-base leading-relaxed opacity-90 md:text-lg lg:col-span-4 lg:justify-self-end lg:text-right">
          {project.summary}
        </p>
      </div>
    </div>
  </section>

  <!-- Meta strip -->
  <section class="w-full border-b border-paper/15 bg-ink py-8 text-paper md:py-10" data-nav-tone="ink">
    <div class="mx-auto grid max-w-content grid-cols-2 gap-8 px-gutter md:grid-cols-4">
      <div>
        <span class="font-label text-xs font-bold uppercase tracking-widest text-paper/50">Client</span>
        <p class:list={["mt-1 font-display text-xl font-bold uppercase md:text-2xl", accent.text]}>{project.client}</p>
      </div>
      <div>
        <span class="font-label text-xs font-bold uppercase tracking-widest text-paper/50">Year</span>
        <p class="mt-1 font-display text-xl font-bold text-paper md:text-2xl">{project.year}</p>
      </div>
      <div>
        <span class="font-label text-xs font-bold uppercase tracking-widest text-paper/50">Category</span>
        <p class="mt-1 font-display text-xl font-bold text-paper md:text-2xl">{project.category}</p>
      </div>
      <div>
        <span class="font-label text-xs font-bold uppercase tracking-widest text-paper/50">Role</span>
        <p class="mt-1 font-display text-xl font-bold text-paper md:text-2xl">Full Creative Execution</p>
      </div>
    </div>
  </section>

  <!-- Overview + deliverables -->
  <section class="w-full bg-ink py-16 text-paper md:py-24" data-nav-tone="ink">
    <div class="mx-auto max-w-content px-gutter">
      <div class="grid gap-14 lg:grid-cols-12 lg:gap-16 xl:gap-20">
        <div class="lg:col-span-6 xl:col-span-7">
          <span class={eyebrowClass}>Overview</span>
          <h2 class="mt-4 font-display text-[clamp(2.75rem,6vw,4.5rem)] font-black uppercase leading-[0.9] tracking-tight">
            The brief behind the work
          </h2>
          <p class="mt-6 max-w-2xl font-body text-base leading-relaxed text-paper/80 md:text-lg">
            {project.overview}
          </p>
        </div>

        <div class="lg:col-span-6 xl:col-span-5">
          <span class={eyebrowClass}>Deliverables</span>
          <ol class="mt-6 space-y-0 border-t border-paper/15">
            {
              project.deliverables.map((item, i) => (
                <li class="flex items-baseline justify-between gap-5 border-b border-paper/15 py-5 md:py-6">
                  <span class="font-display text-base font-bold uppercase tracking-widest text-paper/40 md:text-lg">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <span class="flex-1 font-display text-2xl font-bold uppercase leading-[0.95] tracking-tight text-paper md:text-3xl lg:text-4xl">
                    {item}
                  </span>
                </li>
              ))
            }
          </ol>
          <div class="mt-8 flex flex-wrap gap-3">
            {
              project.deliverables.map((item) => (
                <span
                  class:list={[
                    "inline-flex items-center justify-center rounded-pill border-2 bg-transparent px-5 py-2.5 font-label text-xs font-bold uppercase tracking-wider transition-colors duration-standard md:px-7 md:py-3.5 md:text-sm",
                    accent.border,
                    accent.text,
                    accent.pillHover,
                  ]}
                >
                  {item}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery A — asymmetric opener -->
  <section class="w-full bg-ink pb-8 text-paper md:pb-12" data-nav-tone="ink">
    <div class="mx-auto max-w-content px-gutter">
      <div class="mb-8 flex items-end justify-between gap-4 border-b border-paper/15 pb-4">
        <span class={eyebrowClass}>Selected visuals</span>
        <span class="font-label text-xs font-bold uppercase tracking-widest text-paper/40">01 — Gallery</span>
      </div>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-12 md:gap-5">
        {
          galleryA.map((item) => (
            <div class:list={["col-span-1", spanClass(item)]}>
              <CaseMediaSlot label={item.label} ratio={item.ratio} src={item.src} alt={item.alt} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Challenge + side media -->
  <section class="w-full bg-ink py-16 text-paper md:py-24" data-nav-tone="ink">
    <div class="mx-auto max-w-content px-gutter">
      <div class="grid items-start gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-6">
          <span class={eyebrowClass}>01 / The Challenge</span>
          <h2 class="mt-4 font-display text-[clamp(3rem,6vw,4.75rem)] font-black uppercase leading-[0.88] tracking-tight">
            What needed solving
          </h2>
          <p class="mt-6 max-w-xl font-body text-base leading-relaxed text-paper/80 md:text-lg">
            {project.challenge}
          </p>
        </div>

        {
          challengeMedia && (
            <div class="lg:col-span-6 lg:pt-8">
              <CaseMediaSlot
                label={challengeMedia.label}
                ratio={challengeMedia.ratio}
                src={challengeMedia.src}
                alt={challengeMedia.alt}
              />
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- Gallery B — mosaic -->
  <section class="w-full bg-ink pb-8 text-paper md:pb-12" data-nav-tone="ink">
    <div class="mx-auto max-w-content px-gutter">
      <div class="mb-8 flex items-end justify-between gap-4 border-b border-paper/15 pb-4">
        <span class={eyebrowClass}>More from the case</span>
        <span class="font-label text-xs font-bold uppercase tracking-widest text-paper/40">02 — Mosaic</span>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-12 md:gap-5">
        {
          galleryB.map((item) => (
            <div class:list={["col-span-1", spanClass(item)]}>
              <CaseMediaSlot label={item.label} ratio={item.ratio} src={item.src} alt={item.alt} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Approach + Outcome -->
  <section class="w-full bg-ink py-16 text-paper md:py-28" data-nav-tone="ink">
    <div class="mx-auto max-w-content px-gutter">
      <div class="flex flex-col gap-20 md:gap-28">
        <!-- Approach — copy + wide media -->
        <div class="grid items-center gap-10 border-t border-paper/15 pt-14 lg:grid-cols-12 lg:gap-14 lg:pt-16">
          <div class="lg:col-span-5">
            <span class={eyebrowClass}>02 / The Approach</span>
            <h2 class="mt-4 font-display text-[clamp(2.75rem,5vw,4rem)] font-black uppercase leading-[0.88] tracking-tight">
              How we built it
            </h2>
            <p class="mt-6 font-body text-base leading-relaxed text-paper/80 md:text-lg">
              {project.solution}
            </p>
          </div>

          {
            approachMedia && (
              <div class="lg:col-span-7">
                <CaseMediaSlot
                  label={approachMedia.label}
                  ratio="wide"
                  src={approachMedia.src}
                  alt={approachMedia.alt}
                />
              </div>
            )
          }
        </div>

        <!-- Outcome — media + copy (reversed on desktop) -->
        <div class="grid items-center gap-10 border-t border-paper/15 pt-14 lg:grid-cols-12 lg:gap-14 lg:pt-16">
          {
            outcomeMedia && (
              <div class="order-2 lg:order-1 lg:col-span-7">
                <CaseMediaSlot
                  label={outcomeMedia.label}
                  ratio="wide"
                  src={outcomeMedia.src}
                  alt={outcomeMedia.alt}
                />
              </div>
            )
          }

          <div class="order-1 lg:order-2 lg:col-span-5">
            <span class={eyebrowClass}>03 / The Outcome</span>
            <h2 class="mt-4 font-display text-[clamp(2.75rem,5vw,4rem)] font-black uppercase leading-[0.88] tracking-tight">
              What shipped
            </h2>
            <p class="mt-6 font-body text-base leading-relaxed text-paper/80 md:text-lg">
              {project.outcome}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Next project -->
  <a
    href={`/work/${nextProject.slug}`}
    class={`group relative block w-full overflow-hidden ${nextProject.bg} ${nextProject.textColor} py-24 md:py-32 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-yellow`}
    data-nav-tone={nextNavTone}
  >
    <div class="mx-auto max-w-content px-gutter text-center">
      <span class="text-highlight text-3xl font-bold leading-none opacity-80 md:text-4xl">Next Case Study</span>
      <h2
        class="mt-5 font-display text-[clamp(3rem,8vw,7rem)] font-black uppercase leading-[0.88] tracking-tight transition-transform duration-500 group-hover:translate-x-1"
        transition:name={`project-title-${nextProject.slug}`}
      >
        {nextProject.title}
      </h2>
      <p class="mt-6 font-label text-sm font-bold uppercase tracking-widest opacity-80 md:text-base">
        Explore {nextProject.category} Case →
      </p>
    </div>
  </a>
</BaseLayout>
