---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseMediaSlot from "../../components/ui/CaseMediaSlot.astro";
import CaseColorSlot from "../../components/ui/CaseColorSlot.astro";
import CaseTypographySlot from "../../components/ui/CaseTypographySlot.astro";
import {
  getNextProject,
  getProjectAccent,
  projects,
  type ImageMedia,
} from "../../content/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project, nextProject: getNextProject(project.slug) },
  }));
}

const { project, nextProject } = Astro.props;
const accent = getProjectAccent(project);

const navToneFromBg = (bg: string) =>
  bg.includes("charcoal") || bg.includes("cobalt") ? "ink" : "yellow";

const heroNavTone = navToneFromBg(project.bg);
const nextNavTone = navToneFromBg(nextProject.bg);

const images = project.gallery.filter((item): item is ImageMedia => !item.type || item.type === "image");
const brandColors = project.gallery.find(item => item.type === "color-palette") as any;
const brandTypography = project.gallery.find(item => item.type === "typography") as any;

const firstImage = images[0];
const remainingImages = images.slice(1);

const eyebrowClass = `text-highlight text-3xl font-bold leading-none md:text-4xl lg:text-[2.75rem] ${accent.text}`;
---

<BaseLayout title={`${project.title} — Puff Case Study`} description={project.summary}>
  <!-- Hero -->
  <section
    class={`relative w-full overflow-hidden ${project.bg} ${project.textColor} pt-28 pb-16 md:pt-36 md:pb-24`}
    data-nav-tone={heroNavTone}
  >
    <div class="mx-auto max-w-content px-gutter">
      <div class="flex items-center justify-between border-b border-current/20 pb-8 md:pb-10">
        <a
          href="/#work"
          class="group inline-flex items-center gap-3 font-body text-sm font-medium transition-transform duration-300 hover:-translate-x-1"
        >
          <svg class="size-4 transition-transform duration-300 group-hover:-translate-x-1" fill="none" viewBox="0 0 16 16">
            <path d="M13 8H3M8 12.5 3.5 8 8 3.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
          </svg>
          Back to portfolio
        </a>

        <span class="inline-flex shrink-0 items-center justify-center rounded-pill border-[3px] border-paper px-8 py-3.5 font-display text-2xl font-black uppercase tracking-[0.1em] sm:text-3xl md:px-12 md:py-5 md:text-4xl lg:px-14 lg:py-6 lg:text-5xl xl:text-6xl">
          {project.category}
        </span>
      </div>

      <div class="mt-10 grid gap-10 md:mt-14 lg:grid-cols-12 lg:items-end lg:gap-12">
        <div class="lg:col-span-8">
          <span class="font-display text-3xl font-black opacity-55 md:text-5xl">{project.number}</span>
          <h1
            class="mt-3 font-display text-[clamp(3.5rem,9.5vw,8.5rem)] font-black uppercase leading-[0.86] tracking-tight"
            transition:name={`project-title-${project.slug}`}
          >
            {project.title}
          </h1>
        </div>
        <p class="max-w-md font-body text-base leading-relaxed opacity-90 md:text-lg lg:col-span-4 lg:justify-self-end lg:text-right">
          {project.summary}
        </p>
      </div>
    </div>
  </section>

  <!-- Meta strip -->
  <section class="w-full border-b border-paper/15 bg-ink py-8 text-paper md:py-10" data-nav-tone="ink">
    <div class="mx-auto grid max-w-content grid-cols-2 gap-8 px-gutter md:grid-cols-4">
      <div>
        <span class="font-body text-xs font-semibold text-paper/50">Client</span>
        <p class:list={["mt-1 font-body text-lg font-semibold capitalize md:text-xl", accent.text]}>{project.client}</p>
      </div>
      <div>
        <span class="font-body text-xs font-semibold text-paper/50">Year</span>
        <p class="mt-1 font-body text-lg font-semibold text-paper md:text-xl">{project.year}</p>
      </div>
      <div>
        <span class="font-body text-xs font-semibold text-paper/50">Category</span>
        <p class="mt-1 font-body text-lg font-semibold capitalize text-paper md:text-xl">{project.category}</p>
      </div>
      <div>
        <span class="font-body text-xs font-semibold text-paper/50">Role</span>
        <p class="mt-1 font-body text-lg font-semibold text-paper md:text-xl">Full Creative Execution</p>
      </div>
    </div>
  </section>

  <!-- Overview + deliverables -->
  <section class="w-full bg-ink py-16 text-paper md:py-24" data-nav-tone="ink">
    <div class="mx-auto max-w-content px-gutter">
      <div class="grid gap-14 lg:grid-cols-12 lg:gap-16 xl:gap-20">
        <div class="lg:col-span-6 xl:col-span-7">
          <span class={eyebrowClass}>Overview</span>
          <h2 class="mt-4 font-display text-[clamp(2.75rem,6vw,4.5rem)] font-black uppercase leading-[0.9] tracking-tight">
            The brief behind the work
          </h2>
          <p class="mt-6 max-w-2xl font-body text-base leading-relaxed text-paper/80 md:text-lg">
            {project.overview}
          </p>
        </div>

        <div class="lg:col-span-6 xl:col-span-5">
          <span class={eyebrowClass}>Deliverables</span>
          <ol class="mt-6 space-y-0 border-t border-paper/15">
            {
              project.deliverables.map((item, i) => (
                <li class="flex items-baseline justify-between gap-5 border-b border-paper/15 py-4 md:py-5">
                  <span class="font-body text-sm font-semibold text-paper/40 md:text-base">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <span class="flex-1 font-body text-lg md:text-xl font-medium tracking-normal text-paper capitalize">
                    {item}
                  </span>
                </li>
              ))
            }
          </ol>
          <div class="mt-8 flex flex-wrap gap-3">
            {
              project.deliverables.map((item) => (
                <span
                  class:list={[
                    "inline-flex items-center justify-center rounded-pill border-2 bg-transparent px-5 py-2.5 font-label text-xs font-bold uppercase tracking-wider transition-colors duration-standard md:px-7 md:py-3.5 md:text-sm",
                    accent.border,
                    accent.text,
                    accent.pillHover,
                  ]}
                >
                  {item}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 1. Hero Asset (Full Bleed) -->
  {firstImage && (
    <section class="w-full bg-ink" data-nav-tone="ink">
      <CaseMediaSlot
        label={firstImage.label}
        ratio="wide"
        src={firstImage.src}
        alt={firstImage.alt}
        parallax={true}
        position={firstImage.position}
        class="!rounded-none"
      />
    </section>
  )}

  <!-- 2. Brand Foundation (Full Bleed, No Gap) -->
  {(brandColors || brandTypography) && (
    <section class="w-full bg-ink text-paper" data-nav-tone="ink">
      <div class="w-full">
        {brandColors && !brandTypography && (
          <CaseColorSlot item={brandColors} parallax={false} class="!rounded-none" />
        )}
        {brandTypography && brandColors && (
          <div class="grid grid-cols-1 md:grid-cols-2">
            <CaseTypographySlot item={brandTypography} parallax={false} class="h-full !rounded-none" />
            <CaseColorSlot item={brandColors} parallax={false} class="h-full !rounded-none" />
          </div>
        )}
        {brandTypography && !brandColors && (
          <CaseTypographySlot item={brandTypography} parallax={false} class="!rounded-none" />
        )}
      </div>
    </section>
  )}

  <!-- 3. Statement -->
  {project.statement && (
    <section class={`w-full py-24 md:py-40 ${project.bg} ${project.textColor} flex items-center justify-center`} data-nav-tone={heroNavTone}>
      <div class="mx-auto max-w-content px-gutter text-center case-media">
        <h2 class="font-display text-[clamp(2.5rem,6vw,5.5rem)] font-black uppercase leading-[0.9] tracking-tight">
          "{project.statement}"
        </h2>
      </div>
    </section>
  )}

  <!-- 4. Focused Media Grid -->
  {remainingImages.length > 0 && (
    <section class="w-full bg-ink text-paper" data-nav-tone="ink">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-0 w-full">
        {remainingImages.map((item) => (
          <div class:list={[
            item.span === "half" ? "md:col-span-6 flex" : item.span === "third" ? "md:col-span-4 flex" : "md:col-span-12"
          ]}>
            <CaseMediaSlot
              label={item.label}
              ratio={item.ratio}
              span={item.span}
              src={item.src}
              alt={item.alt}
              parallax={true}
              position={item.position}
              class="h-full !rounded-none"
            />
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Next project -->
  <a
    href={`/work/${nextProject.slug}`}
    class={`group relative block w-full overflow-hidden ${nextProject.bg} ${nextProject.textColor} py-24 md:py-32 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-yellow`}
    data-nav-tone={nextNavTone}
  >
    <div class="mx-auto max-w-content px-gutter text-center">
      <span class="text-highlight text-3xl font-bold leading-none opacity-80 md:text-4xl">Next Case Study</span>
      <h2
        class="mt-5 font-display text-[clamp(3rem,8vw,7rem)] font-black uppercase leading-[0.88] tracking-tight transition-transform duration-500 group-hover:translate-x-1"
        transition:name={`project-title-${nextProject.slug}`}
      >
        {nextProject.title}
      </h2>
      <p class="mt-6 font-body text-sm font-semibold capitalize opacity-80 md:text-base">
        Explore {nextProject.category} case →
      </p>
    </div>
  </a>
</BaseLayout>

<script>
  import { initParallaxImages } from "../../scripts/motion/parallax";
  import { initGalleryReveal } from "../../scripts/motion/gallery-reveal";

  document.addEventListener("DOMContentLoaded", () => {
    initParallaxImages();
    initGalleryReveal();
  });
  document.addEventListener("astro:page-load", () => {
    initParallaxImages();
    initGalleryReveal();
  });
</script>
