---
import Cta from "../components/sections/Cta.astro";
import Faq from "../components/sections/Faq.astro";
import HeroMediaSequence from "../components/sections/HeroMediaSequence.astro";
import Portfolio from "../components/sections/Portfolio.astro";
import Pricing from "../components/sections/Pricing.astro";
import Process from "../components/sections/Process.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import { landingContent } from "../content/landing";
import BannerMarquee from "../components/sections/BannerMarquee.astro";
import Services from "../components/sections/Services.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={landingContent.hero.value.heading} description={landingContent.hero.value.body}>
  <HeroMediaSequence />
  <Process />
  <BannerMarquee />
  <Services />
  <BannerMarquee />
  <Portfolio />
  <Testimonials />
  <Pricing />
  <Faq />
  <Cta />
</BaseLayout>
