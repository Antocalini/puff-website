---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import PrismGrid from "../components/ui/PrismGrid";
---

<BaseLayout title="Hero Layouts Lab | Puff Cross Media" description="Interactive playground to test and compare different Hero layout treatments" showPreloader={false}>
  <div class="relative bg-brand-yellow min-h-dvh">
    <div
      class="pointer-events-none absolute inset-0 z-[1] min-h-full w-full"
      data-prism-grid-layer
      aria-hidden="true"
    >
      <div class="prism-grid-host absolute inset-0 h-full w-full">
        <PrismGrid client:idle />
      </div>
    </div>
    <div class="relative z-10">
      <Hero />
    </div>
  </div>
</BaseLayout>

<style>
  [data-prism-grid-layer] {
    background-color: var(--color-brand-yellow);
    background-image:
      linear-gradient(to right, rgb(26 26 26 / 0.065) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(26 26 26 / 0.065) 1px, transparent 1px);
    background-size: 40px 40px;
    background-position: 0 0;
  }
</style>
